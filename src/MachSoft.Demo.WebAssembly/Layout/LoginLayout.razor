@inherits LayoutComponentBase
@implements IDisposable

<div class="mx-app-login-layout-shell">
    <button type="button" class="mx-app-login-theme" @onclick="ToggleTheme">
        <MudIcon Icon="@(ShellState.DarkMode ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode)" />
        <span>@(ShellState.DarkMode ? "Tema oscuro" : "Tema claro")</span>
    </button>
    @Body
</div>

@code {
    [Inject] private MachSoft.Demo.WebAssembly.Services.ShellState ShellState { get; set; } = default!;

    protected override void OnInitialized()
    {
        ShellState.Changed += OnShellStateChanged;
    }

    public void Dispose()
    {
        ShellState.Changed -= OnShellStateChanged;
    }

    private void OnShellStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleTheme()
    {
        ShellState.SetDarkMode(!ShellState.DarkMode);
    }
}
