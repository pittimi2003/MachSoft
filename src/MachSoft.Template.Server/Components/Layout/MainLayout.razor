@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject MachSoft.Template.Server.Services.ShellState ShellState

<MxWorkspaceLayout MainMenuOpen="@MainMenuOpen"
                   MainMenuOpenChanged="@OnMainMenuOpenChanged"
                   NavigationMenuMode="MxSidebarMode.Overlay"
                   NavigationMenuWidth="280px"
                   LeftSidebarMode="@LeftSidebarMode"
                   LeftSidebarModeChanged="@OnLeftSidebarModeChanged"
                   LeftSidebarWidth="@LeftSidebarWidth"
                   LeftSidebarOpen="@LeftSidebarOpen"
                   LeftSidebarOpenChanged="@OnLeftSidebarOpenChanged"
                   RightSidebarMode="@RightSidebarMode"
                   RightSidebarModeChanged="@OnRightSidebarModeChanged"
                   RightSidebarWidth="@RightSidebarWidth"
                   RightSidebarOpen="@RightSidebarOpen"
                   RightSidebarOpenChanged="@OnRightSidebarOpenChanged"
                   DarkMode="@ShellState.DarkMode"
                   DarkModeChanged="@OnDarkModeChanged"
                   OnBackdropClick="@OnBackdropClick">
    <HeaderContent>
        <div class="mx-app-shell-header-row">
            <div class="mx-app-shell-brand">
                <span class="mx-app-shell-brand-mark" aria-hidden="true">MS</span>
                <span class="mx-app-shell-brand-copy">
                    <span class="mx-app-shell-brand-title">MachSoft App Base</span>
                    <span class="mx-app-shell-brand-subtitle">Template Server</span>
                </span>
            </div>
            <div class="mx-app-shell-actions">
                <MxIconButton Icon="@(ShellState.DarkMode ? Icons.Material.Outlined.DarkMode : Icons.Material.Outlined.LightMode)"
                              Tone="MxTone.Neutral"
                              Size="MxSize.Small"
                              Class="mx-app-shell-action-header"
                              AriaLabel="Cambiar tema global"
                              Title="Tema"
                              OnClick="_ => ToggleTheme()" />
            </div>
        </div>
    </HeaderContent>

    <NavigationMenu>
        <nav class="mx-app-nav" aria-label="Navegación global">
            <NavLink Match="NavLinkMatch.All" class="mx-workspace-nav-link" href="/">Home</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/login">Login</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/work">Work</NavLink>
        </nav>
    </NavigationMenu>

    <LeftSidebar>
        @if (IsWorkRoute)
        {
            <section class="mx-app-left-rail" aria-label="Rail operativo izquierdo">
                <MxSectionCard Title="Navegación" >
                    <div class="mx-app-left-rail-group" role="group" aria-label="Modo de trabajo">
                        @foreach (var action in RailModes)
                        {
                            <MxButton Label="@action.Label"
                                      Variant="@(action.Mode == ShellState.WorkMode ? MxVariant.Filled : MxVariant.Outlined)"
                                      Tone="@(action.Mode == ShellState.WorkMode ? MxTone.Primary : MxTone.Neutral)"
                                      Size="MxSize.Small"
                                      Class="mx-app-left-rail-action"
                                      Disabled="@action.Disabled"
                                      OnClick="_ => SetWorkMode(action.Mode)" />
                        }
                    </div>
                </MxSectionCard>

                <MxSectionCard Title="Acciones rápidas">
                    <div class="mx-app-left-rail-group" role="group" aria-label="Acciones rápidas">
                        <MxButton Label="Limpiar selección"
                                  Variant="MxVariant.Outlined"
                                  Tone="MxTone.Neutral"
                                  Size="MxSize.Small"
                                  Class="mx-app-left-rail-action"
                                  Disabled="@(!ShellState.WorkSelectionActive)"
                                  OnClick="_ => ClearContextSelection()" />
                        <MxButton Label="Volver al listado"
                                  Variant="MxVariant.Text"
                                  Tone="MxTone.Neutral"
                                  Size="MxSize.Small"
                                  Class="mx-app-left-rail-action"
                                  OnClick='@(_ => SetWorkMode("browse"))' />
                    </div>
                </MxSectionCard>
            </section>
        }
    </LeftSidebar>

    <MainContent>
        @Body
    </MainContent>

    <RightSidebar>
        @if (IsWorkRoute)
        {
            <section class="mx-workspace-panel" aria-label="Panel contextual derecho">
                <MxSectionCard Title="Registro activo">
                    <header class="mx-workspace-panel-header">
                        <div>
                            <h4>@CurrentModeLabel</h4>
                            <p class="mx-workspace-panel-caption">@SelectionCaption</p>
                        </div>
                        <MxTag Text="Contexto" Tone="MxTone.Neutral" />
                    </header>

                    @if (ShellState.WorkSelectionActive)
                    {
                        @if (!string.IsNullOrWhiteSpace(ShellState.WorkSelectionTitle))
                        {
                            <h5>@ShellState.WorkSelectionTitle</h5>
                        }

                        <div class="mx-workspace-panel-details">
                            @foreach (var detail in ShellState.WorkSelectionDetails)
                            {
                                <p>@detail</p>
                            }
                        </div>

                        <div class="mx-workspace-panel-actions">
                            <MxButton Label="Abrir detalle" Variant="MxVariant.Filled" Tone="MxTone.Primary" Size="MxSize.Small" OnClick='@(_ => SetWorkMode("detail"))' />
                            <MxButton Label="Editar" Variant="MxVariant.Outlined" Tone="MxTone.Primary" Size="MxSize.Small" OnClick='@(_ => SetWorkMode("edit"))' />
                        </div>
                    }
                    else
                    {
                        <p class="mx-workspace-panel-empty">Selecciona un registro para ver su información y acciones disponibles.</p>
                    }
                </MxSectionCard>
            </section>
        }
    </RightSidebar>
</MxWorkspaceLayout>

@code {
    private bool MainMenuOpen { get; set; }
    private bool LeftSidebarOpen { get; set; }
    private bool RightSidebarOpen { get; set; }
    private MxSidebarMode LeftSidebarMode { get; set; } = MxSidebarMode.Overlay;
    private MxSidebarMode RightSidebarMode { get; set; } = MxSidebarMode.Overlay;
    private string LeftSidebarWidth { get; set; } = "272px";
    private string RightSidebarWidth { get; set; } = "360px";
    private bool IsWorkRoute { get; set; }

    private IReadOnlyList<(string Mode, string Label, bool Disabled)> RailModes =>
    [
        ("browse", "Listado", false),
        ("new", "Nuevo", false),
        ("detail", "Detalle", !ShellState.WorkSelectionActive),
        ("edit", "Editar", !ShellState.WorkSelectionActive)
    ];

    private string CurrentModeLabel => ShellState.WorkMode switch
    {
        "new" => "Nuevo",
        "detail" => "Detalle",
        "edit" => "Edición",
        _ => "Listado"
    };

    private string SelectionCaption => ShellState.WorkSelectionActive
        ? $"{ShellState.WorkSelectionCount} seleccionado(s)"
        : "Sin selección";

    protected override void OnInitialized()
    {
        ApplyRoutePolicy(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        ShellState.Changed += OnShellStateChanged;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ShellState.Changed -= OnShellStateChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyRoutePolicy(e.Location);
        SyncWorkSelectionState();
        InvokeAsync(StateHasChanged);
    }

    private void OnShellStateChanged()
    {
        SyncWorkSelectionState();
        InvokeAsync(StateHasChanged);
    }

    private void ApplyRoutePolicy(string location)
    {
        var route = NavigationManager.ToBaseRelativePath(location);
        IsWorkRoute = route.StartsWith("work", StringComparison.OrdinalIgnoreCase);
        var isLoginRoute = route.StartsWith("login", StringComparison.OrdinalIgnoreCase);

        if (IsWorkRoute)
        {
            LeftSidebarMode = MxSidebarMode.Inline;
            RightSidebarMode = MxSidebarMode.Overlay;
            LeftSidebarWidth = "220px";
            RightSidebarWidth = "360px";
            LeftSidebarOpen = false;
            RightSidebarOpen = false;
        }
        else
        {
            LeftSidebarMode = MxSidebarMode.Overlay;
            RightSidebarMode = MxSidebarMode.Overlay;
            LeftSidebarWidth = "272px";
            RightSidebarWidth = "360px";
            LeftSidebarOpen = false;
            RightSidebarOpen = false;
        }

        if (isLoginRoute)
        {
            MainMenuOpen = false;
            LeftSidebarOpen = false;
            RightSidebarOpen = false;
        }

        SyncWorkSelectionState();
    }

    private void SyncWorkSelectionState()
    {
        var hasContext = ShellState.WorkSelectionActive || string.Equals(ShellState.WorkMode, "edit", StringComparison.OrdinalIgnoreCase);
        RightSidebarOpen = IsWorkRoute && hasContext;
    }

    private Task OnDarkModeChanged(bool enabled)
    {
        ShellState.SetDarkMode(enabled);
        return Task.CompletedTask;
    }

    private Task OnMainMenuOpenChanged(bool isOpen)
    {
        MainMenuOpen = isOpen;
        return Task.CompletedTask;
    }

    private Task OnLeftSidebarOpenChanged(bool isOpen)
    {
        LeftSidebarOpen = isOpen;
        return Task.CompletedTask;
    }

    private Task OnLeftSidebarModeChanged(MxSidebarMode mode)
    {
        LeftSidebarMode = mode;
        return Task.CompletedTask;
    }

    private Task OnRightSidebarOpenChanged(bool isOpen)
    {
        RightSidebarOpen = isOpen;
        return Task.CompletedTask;
    }

    private Task OnRightSidebarModeChanged(MxSidebarMode mode)
    {
        RightSidebarMode = mode;
        return Task.CompletedTask;
    }

    private Task OnBackdropClick()
    {
        MainMenuOpen = false;
        LeftSidebarOpen = false;
        RightSidebarOpen = false;
        return Task.CompletedTask;
    }

    private void ToggleTheme()
    {
        ShellState.SetDarkMode(!ShellState.DarkMode);
    }

    private void SetWorkMode(string mode)
    {
        if ((string.Equals(mode, "detail", StringComparison.OrdinalIgnoreCase) || string.Equals(mode, "edit", StringComparison.OrdinalIgnoreCase))
            && !ShellState.WorkSelectionActive)
        {
            return;
        }

        ShellState.SetWorkMode(mode);
    }

    private void ClearContextSelection()
    {
        ShellState.ClearWorkSelection();
        ShellState.SetWorkMode("browse");
    }
}
