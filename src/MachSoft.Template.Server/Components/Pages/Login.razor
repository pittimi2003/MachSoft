@page "/login"
@layout MachSoft.Template.Server.Components.Layout.LoginLayout

<section class="mx-app-login-screen">
    <div class="mx-app-login-visual" aria-hidden="true">
        <div class="mx-app-login-branding">
            <span class="mx-app-login-logo">MS</span>
            <div>
                <p class="mx-app-login-brand-eyebrow">MachSoft Platform</p>
                <h1>Control Center</h1>
                <p>Acceso único institucional a los módulos operativos.</p>
            </div>
        </div>
    </div>

    <div class="mx-app-login-panel">
        <header>
            <p class="mx-app-login-panel-kicker">Ingreso seguro</p>
            <h2>Bienvenido</h2>
        </header>

        <MxTextField Label="Usuario" @bind-Value="User" Required="true" />
        <MxTextField Label="Contraseña" @bind-Value="Password" Required="true" />
        <MxSelect Label="Idioma" @bind-Value="Language" Options="_languages" />

        <div class="mx-app-login-actions">
            <MxButton Label="Limpiar" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" OnClick="_ => Clear()" />
            <MxButton Label="Acceder" Variant="MxVariant.Filled" Tone="MxTone.Primary" Href="/" />
        </div>
    </div>
</section>

@code {
    private string? User;
    private string? Password;
    private string? Language = "Español";

    private readonly IReadOnlyList<string> _languages = ["Español", "English", "Português"];

    private Task Clear()
    {
        User = string.Empty;
        Password = string.Empty;
        Language = _languages[0];
        return Task.CompletedTask;
    }
}
