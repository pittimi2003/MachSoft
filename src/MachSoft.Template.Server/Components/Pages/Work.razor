@page "/work"
@using MachSoft.Template.Server.Services

<section class="mx-app-work-surface" aria-label="Superficie de trabajo">
    <aside class="mx-app-work-rail" aria-label="Acciones rápidas">
        <button type="button" class="mx-app-rail-action is-active" title="Editar"><MudIcon Icon="@Icons.Material.Outlined.Edit" /></button>
        <button type="button" class="mx-app-rail-action" title="Duplicar"><MudIcon Icon="@Icons.Material.Outlined.ContentCopy" /></button>
        <button type="button" class="mx-app-rail-action" title="Deshabilitar"><MudIcon Icon="@Icons.Material.Outlined.Block" /></button>
        <button type="button" class="mx-app-rail-action" title="Exportar"><MudIcon Icon="@Icons.Material.Outlined.FileDownload" /></button>
    </aside>

    <div class="mx-app-work-main">
        <header class="mx-app-work-toolbar">
            <div class="mx-app-work-toolbar-actions">
                <MxButton Label="Nuevo" Variant="MxVariant.Filled" Tone="MxTone.Primary" />
                <MxButton Label="Sincronizar" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" />
            </div>
            <MxSearchBox Label="Buscar" Value="@Search" ValueChanged="@OnSearchChanged" Placeholder="Código, nombre, estado" />
        </header>

        <div class="mx-app-work-grid-shell">
            <MxDataGrid TItem="WorkItem"
                        Items="@FilteredItems"
                        Columns="@Columns"
                        SearchEnabled="false"
                        UsePagination="true"
                        CurrentPage="@Page"
                        CurrentPageChanged="@OnPageChanged"
                        PageSize="10"
                        Selectable="true"
                        SelectedItems="@SelectedItems"
                        SelectedItemsChanged="@OnSelectedItemsChanged" />
        </div>
    </div>

    <aside class="mx-app-work-context" data-open="@HasSelection.ToString().ToLowerInvariant()" aria-label="Panel contextual">
        <div class="mx-app-work-context-head">
            <h3>Detalle</h3>
            <MxIconButton Icon="@(HasSelection ? Icons.Material.Outlined.Close : Icons.Material.Outlined.ChevronRight)"
                          AriaLabel="Alternar panel contextual"
                          Tone="MxTone.Neutral"
                          OnClick="@(_ => ToggleContext())" />
        </div>

        @if (HasSelection)
        {
            var current = SelectedItems.Last();
            <dl>
                <dt>Código</dt><dd>@current.Code</dd>
                <dt>Nombre</dt><dd>@current.Name</dd>
                <dt>Estado</dt><dd>@current.Status</dd>
                <dt>Responsable</dt><dd>@current.Owner</dd>
            </dl>
        }
        else
        {
            <p class="mx-app-work-context-empty">Selecciona un registro para abrir el detalle contextual.</p>
        }
    </aside>
</section>

@code {
    private string? Search;
    private int Page = 1;

    private IReadOnlyCollection<WorkItem> SelectedItems { get; set; } = Array.Empty<WorkItem>();
    private bool HasSelection => SelectedItems.Count > 0;

    private static IReadOnlyList<MxDataGridColumn<WorkItem>> Columns { get; } =
    [
        new("code", "Código", item => item.Code) { IsPrimary = true },
        new("name", "Nombre", item => item.Name),
        new("status", "Estado", item => item.Status),
        new("owner", "Responsable", item => item.Owner),
        new("updated", "Actualizado", item => item.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss")) { Align = "right" }
    ];

    private IReadOnlyList<WorkItem> FilteredItems => WorkSeed.Items.Where(Matches).ToArray();

    private bool Matches(WorkItem item)
    {
        if (string.IsNullOrWhiteSpace(Search))
        {
            return true;
        }

        return item.Code.Contains(Search, StringComparison.OrdinalIgnoreCase)
               || item.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)
               || item.Status.Contains(Search, StringComparison.OrdinalIgnoreCase)
               || item.Owner.Contains(Search, StringComparison.OrdinalIgnoreCase);
    }

    private Task OnSearchChanged(string? term)
    {
        Search = term;
        Page = 1;
        return Task.CompletedTask;
    }

    private Task OnPageChanged(int page)
    {
        Page = page;
        return Task.CompletedTask;
    }

    private Task OnSelectedItemsChanged(IReadOnlyCollection<WorkItem> selected)
    {
        SelectedItems = selected;
        return Task.CompletedTask;
    }

    private Task ToggleContext()
    {
        if (HasSelection)
        {
            SelectedItems = Array.Empty<WorkItem>();
        }

        return Task.CompletedTask;
    }
}
