@page "/work"
@using MachSoft.Template.Server.Services
@implements IDisposable
@inject ShellState ShellState

<section class="mx-app-work-shell" aria-label="Superficie de trabajo">
    <MxEntityHeader Title="Operaciones" Subtitle="@($"{CurrentModeLabel} · {SelectionCountLabel}")">
        <Meta>
            <MxTag Text="Work" Tone="MxTone.Primary" />
        </Meta>
    </MxEntityHeader>

    <div class="mx-app-work-toolbar" role="toolbar" aria-label="Acciones de listado">
        <div class="mx-app-work-toolbar-actions">
            <MxButton Label="Actualizar" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" Size="MxSize.Small" OnClick="_ => RefreshList()" />
            <MxButton Label="Detalle" Variant="@(CurrentMode == DetailMode ? MxVariant.Filled : MxVariant.Outlined)" Tone="MxTone.Primary" Size="MxSize.Small" Disabled="@(!HasSelection)" OnClick="_ => SetMode(DetailMode)" />
            <MxButton Label="Editar" Variant="@(CurrentMode == EditMode ? MxVariant.Filled : MxVariant.Outlined)" Tone="MxTone.Primary" Size="MxSize.Small" Disabled="@(!HasSelection)" OnClick="_ => SetMode(EditMode)" />
            <MxButton Label="Nuevo" Variant="@(CurrentMode == NewMode ? MxVariant.Filled : MxVariant.Outlined)" Tone="MxTone.Secondary" Size="MxSize.Small" OnClick="_ => SetMode(NewMode)" />
        </div>
        <div class="mx-app-work-toolbar-meta">
            <span>@CurrentModeLabel</span>
            <span>·</span>
            <span>@SelectionCountLabel</span>
        </div>
    </div>

    @if (CurrentMode == NewMode)
    {
        <MxSectionCard Title="Nuevo registro de trabajo">
            <MxFormSection Title="Datos principales">
                <div class="mx-app-work-form-grid">
                    <MxTextField Label="Código" Placeholder="WK-10XX" Value="@DraftCode" ValueChanged="OnDraftCodeChanged" />
                    <MxTextField Label="Nombre" Placeholder="Descripción de tarea" Value="@DraftName" ValueChanged="OnDraftNameChanged" />
                    <MxTextField Label="Responsable" Placeholder="Nombre de responsable" Value="@DraftOwner" ValueChanged="OnDraftOwnerChanged" />
                </div>
            </MxFormSection>
            <div class="mx-app-work-state-actions">
                <MxButton Label="Cancelar" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" Size="MxSize.Small" OnClick="_ => SetMode(BrowseMode)" />
                <MxButton Label="Guardar" Variant="MxVariant.Filled" Tone="MxTone.Primary" Size="MxSize.Small" Disabled="@IsDraftIncomplete" OnClick="_ => SaveDraft()" />
            </div>
        </MxSectionCard>
    }
    else
    {
        <div class="mx-app-work-surface">
            <div class="mx-app-work-grid-shell">
                <MxDataGrid TItem="WorkItem"
                            Items="@FilteredItems"
                            Columns="@Columns"
                            Title="Listado operativo"
                            Subtitle="@($"{FilteredItems.Count} registros · Página {Page}")"
                            SearchEnabled="true"
                            SearchPlaceholder="Buscar por código, nombre, estado o responsable"
                            QuickFilters="@QuickFilters"
                            QuickFilterPredicate="@MatchQuickFilter"
                            UsePagination="true"
                            CurrentPage="@Page"
                            CurrentPageChanged="@OnPageChanged"
                            PageSize="10"
                            Selectable="true"
                            SelectedItems="@SelectedItems"
                            SelectedItemsChanged="@OnSelectedItemsChanged" />
            </div>
        </div>
    }
</section>

@code {
    private const string BrowseMode = "browse";
    private const string DetailMode = "detail";
    private const string EditMode = "edit";
    private const string NewMode = "new";

    private static readonly IReadOnlyList<string> QuickFilters = ["Todos", "Activos", "Pausados", "Completados"];

    private static IReadOnlyList<MxDataGridColumn<WorkItem>> Columns { get; } =
    [
        new("code", "Código", item => item.Code) { IsPrimary = true },
        new("name", "Nombre", item => item.Name),
        new("status", "Estado", item => item.Status),
        new("owner", "Responsable", item => item.Owner),
        new("updated", "Actualizado", item => item.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss")) { Align = "right" }
    ];

    private int Page = 1;
    private bool suppressShellEvent;

    private string CurrentMode { get; set; } = BrowseMode;
    private string DraftCode { get; set; } = string.Empty;
    private string DraftName { get; set; } = string.Empty;
    private string DraftOwner { get; set; } = string.Empty;

    private IReadOnlyCollection<WorkItem> SelectedItems { get; set; } = Array.Empty<WorkItem>();

    private IReadOnlyList<WorkItem> FilteredItems => WorkSeed.Items;

    private bool HasSelection => SelectedItems.Count > 0;

    private bool IsDraftIncomplete =>
        string.IsNullOrWhiteSpace(DraftCode)
        || string.IsNullOrWhiteSpace(DraftName)
        || string.IsNullOrWhiteSpace(DraftOwner);

    private string CurrentModeLabel => CurrentMode switch
    {
        NewMode => "Nuevo",
        DetailMode => "Detalle",
        EditMode => "Edición",
        _ => "Listado"
    };

    private string SelectionCountLabel => HasSelection
        ? $"{SelectedItems.Count} seleccionado(s)"
        : "Sin selección";

    protected override void OnInitialized()
    {
        SelectedItems = Array.Empty<WorkItem>();
        ShellState.Changed += OnShellStateChanged;
        SyncSelectionWithShell();
        SetMode(BrowseMode, syncShell: true);
    }

    public void Dispose()
    {
        ShellState.Changed -= OnShellStateChanged;
        if (ShellState.WorkSelectionActive)
        {
            ShellState.ClearWorkSelection();
        }

        ShellState.SetWorkMode(BrowseMode);
    }

    private Task OnPageChanged(int page)
    {
        Page = page;
        return Task.CompletedTask;
    }

    private Task OnDraftCodeChanged(string? value)
    {
        DraftCode = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnDraftNameChanged(string? value)
    {
        DraftName = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnDraftOwnerChanged(string? value)
    {
        DraftOwner = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private bool MatchQuickFilter(WorkItem item, string filter)
    {
        return filter switch
        {
            "Activos" => item.Status.Contains("curso", StringComparison.OrdinalIgnoreCase),
            "Pausados" => item.Status.Contains("pausa", StringComparison.OrdinalIgnoreCase),
            "Completados" => item.Status.Contains("cerrad", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }

    private Task OnSelectedItemsChanged(IReadOnlyCollection<WorkItem> selected)
    {
        SelectedItems = selected;
        SyncSelectionWithShell();

        if (!HasSelection && (CurrentMode == DetailMode || CurrentMode == EditMode))
        {
            SetMode(BrowseMode);
        }
        else if (HasSelection && CurrentMode == BrowseMode)
        {
            SetMode(DetailMode);
        }

        return Task.CompletedTask;
    }

    private Task RefreshList()
    {
        Page = 1;
        return Task.CompletedTask;
    }

    private Task SaveDraft()
    {
        DraftCode = string.Empty;
        DraftName = string.Empty;
        DraftOwner = string.Empty;
        SetMode(BrowseMode);
        return Task.CompletedTask;
    }

    private void SetMode(string? mode, bool syncShell = true)
    {
        var normalized = NormalizeMode(mode);

        if ((normalized == DetailMode || normalized == EditMode) && !HasSelection)
        {
            normalized = BrowseMode;
        }

        if (syncShell && normalized == NewMode && HasSelection)
        {
            SelectedItems = Array.Empty<WorkItem>();
            SyncSelectionWithShell();
        }

        if (string.Equals(CurrentMode, normalized, StringComparison.Ordinal))
        {
            return;
        }

        CurrentMode = normalized;

        if (!syncShell)
        {
            return;
        }

        suppressShellEvent = true;
        ShellState.SetWorkMode(normalized);
        suppressShellEvent = false;
    }

    private void OnShellStateChanged()
    {
        if (suppressShellEvent)
        {
            return;
        }

        var shellMode = NormalizeMode(ShellState.WorkMode);
        if (!string.Equals(CurrentMode, shellMode, StringComparison.Ordinal))
        {
            SetMode(shellMode, syncShell: false);
        }

        InvokeAsync(StateHasChanged);
    }

    private void SyncSelectionWithShell()
    {
        var first = SelectedItems.FirstOrDefault();
        var details = first is null
            ? Array.Empty<string>()
            :
            [
                $"Estado: {first.Status}",
                $"Responsable: {first.Owner}",
                $"Actualizado: {first.UpdatedAtUtc.ToLocalTime():dd/MM/yyyy HH:mm:ss}"
            ];

        var selectionCount = SelectedItems.Count;
        var hasSelection = selectionCount > 0;
        var title = hasSelection ? first?.Name : null;

        var hasSameSelection = ShellState.WorkSelectionCount == selectionCount
            && ShellState.WorkSelectionActive == hasSelection
            && string.Equals(ShellState.WorkSelectionTitle, title, StringComparison.Ordinal)
            && ShellState.WorkSelectionDetails.SequenceEqual(details);

        if (hasSameSelection)
        {
            return;
        }

        if (hasSelection)
        {
            ShellState.SetWorkSelection(selectionCount, title, details);
        }
        else
        {
            ShellState.ClearWorkSelection();
        }
    }

    private static string NormalizeMode(string? mode)
    {
        var candidate = mode?.Trim();
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return BrowseMode;
        }

        return candidate.ToLowerInvariant() switch
        {
            NewMode => NewMode,
            DetailMode => DetailMode,
            EditMode => EditMode,
            _ => BrowseMode
        };
    }
}
