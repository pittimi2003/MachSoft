@inherits LayoutComponentBase

<MxWorkspaceLayout MainMenuOpen="@MainMenuOpen"
                   MainMenuOpenChanged="@OnMainMenuOpenChanged"
                   NavigationMenuMode="MxSidebarMode.Overlay"
                   NavigationMenuWidth="280px"
                   OnBackdropClick="@OnBackdropClick">
    <HeaderContent>
        <div class="mx-showcase-topbar">
            <div class="mx-showcase-brand-wrap">
                <span class="mx-showcase-brand-mark" aria-hidden="true">MS</span>
                <div class="mx-showcase-brand-block">
                    <span class="mx-showcase-brand">Template Wasm</span>
                    <span class="mx-showcase-brand-subtitle">MachSoft.UI workspace shell</span>
                </div>
            </div>
        </div>
    </HeaderContent>

    <NavigationMenu>
        <nav class="mx-workspace-nav" aria-label="Template Wasm">
            <NavLink Match="NavLinkMatch.All" class="mx-workspace-nav-link" href="/">Dashboard</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/form">Formulario</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/list">Lista</NavLink>
        </nav>
    </NavigationMenu>

    <MainContent>@Body</MainContent>
</MxWorkspaceLayout>

@code {
    private bool MainMenuOpen { get; set; }

    private Task OnMainMenuOpenChanged(bool isOpen)
    {
        MainMenuOpen = isOpen;
        return Task.CompletedTask;
    }

    private Task OnBackdropClick()
    {
        MainMenuOpen = false;
        return Task.CompletedTask;
    }
}
