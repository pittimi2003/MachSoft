@page "/form"
<MxPageContainer Title="Formulario">
<MxSectionCard>
<MxTextField Label="Nombre" @bind-Value="Name" />
<MxSelect Label="Perfil" @bind-Value="Role" Options="_roles" />
<MxButton Label="Guardar" />
</MxSectionCard>
</MxPageContainer>
@code {
  private string? Name;
  private string? Role;
  private readonly List<string> _roles = ["Admin", "Operador"];
}
