@page "/work"
@using MachSoft.Template.Wasm.Services
@using MachSoft.UI.Models
@implements IDisposable
@inject ShellState ShellState

<MxWorkspaceLayout LeftSidebarWidth="280px"
                   RightSidebarWidth="360px"
                   LeftSidebarMode="MxSidebarMode.Inline"
                   RightSidebarMode="MxSidebarMode.Inline"
                   LeftSidebarOpen="@(!IsNewMode)"
                   RightSidebarOpen="@IsDetailsVisible"
                   EnableMobileContextualDetailMode="true"
                   RightSidebarCloseLabel="Volver al listado">
    <LeftSidebar>
        <div class="mx-work-leftbar">
            @foreach (var action in LeftActions)
            {
                <MxButton Label="@action.Label"
                          Variant="@(action.Active ? MxVariant.Filled : MxVariant.Outlined)"
                          Tone="@(action.Active ? MxTone.Primary : MxTone.Neutral)"
                          Size="MxSize.Small"
                          Disabled="@action.Disabled"
                          Class="mx-work-leftbar__action"
                          OnClick="_ => ExecuteLeftAction(action.Key)" />
            }
        </div>
    </LeftSidebar>

    <MainContent>
        @if (IsNewMode)
        {
            <div class="mx-work-new-mode">
                <div class="mx-work-new-mode__surface">
                    <div class="mx-work-new-mode__header">
                        <div class="mx-work-new-mode__title-wrap">
                            <span class="mx-work-new-mode__title">DATA</span>
                            <span class="mx-work-new-mode__underline"></span>
                        </div>
                    </div>

                    <div class="mx-work-new-mode__content">
                        <div class="mx-work-new-mode__data">
                            <MxSectionCard Title="">
                                <div class="mx-work-form-grid">
                                    <MxTextField Label="Código"
                                                 Placeholder="WK-10XX"
                                                 Value="@DraftCode"
                                                 ValueChanged="OnDraftCodeChanged"
                                                 Required="true" />
                                    <MxTextField Label="Nombre"
                                                 Placeholder="Descripción de tarea"
                                                 Value="@DraftName"
                                                 ValueChanged="OnDraftNameChanged"
                                                 Required="true" />
                                    <MxTextField Label="Responsable"
                                                 Placeholder="Nombre de responsable"
                                                 Value="@DraftOwner"
                                                 ValueChanged="OnDraftOwnerChanged"
                                                 Required="true" />
                                </div>
                            </MxSectionCard>
                        </div>
                    </div>

                    <div class="mx-work-new-mode__footer">
                        <MxButton Label="Cancel"
                                  Variant="MxVariant.Outlined"
                                  Tone="MxTone.Neutral"
                                  Size="MxSize.Small"
                                  OnClick="_ => CancelEvent()" />
                        <MxButton Label="Save"
                                  Variant="MxVariant.Filled"
                                  Tone="MxTone.Primary"
                                  Size="MxSize.Small"
                                  Disabled="@IsSaveDisabled"
                                  OnClick="_ => SaveEvent()" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="mx-work-main-grid">
                <MxDataGrid TItem="WorkItem"
                            Items="@FilteredItems"
                            Columns="@Columns"
                            Title=""
                            Subtitle=""
                            SearchEnabled="false"
                            Selectable="true"
                            SelectOnRowClick="true"
                            SelectedItems="@SelectedItems"
                            SelectedItemsChanged="OnSelectedItemsChanged"
                            UsePagination="true"
                            CurrentPage="@Page"
                            CurrentPageChanged="OnPageChanged"
                            PageSize="10"
                            TotalItems="@FilteredItems.Count" />
            </div>
        }
    </MainContent>

    <RightSidebar>
        @if (ActiveItem is not null)
        {
            <div class="mx-work-rightbar">
                <MxSectionCard Title="Detail">
                    <div class="mx-work-rightbar__meta">
                        <p><strong>Código:</strong> @ActiveItem.Code</p>
                        <p><strong>Nombre:</strong> @ActiveItem.Name</p>
                        <p><strong>Estado:</strong> @ActiveItem.Status</p>
                        <p><strong>Responsable:</strong> @ActiveItem.Owner</p>
                        <p><strong>Actualizado:</strong> @ActiveItem.UpdatedAtUtc.ToLocalTime():dd/MM/yyyy HH:mm:ss</p>
                    </div>
                </MxSectionCard>
            </div>
        }
    </RightSidebar>
</MxWorkspaceLayout>

<style>
    .mx-work-leftbar {
        display: flex;
        flex-direction: column;
        gap: var(--mx-space-2, 0.5rem);
        padding: var(--mx-space-3, 0.75rem);
        height: 100%;
    }

    .mx-work-leftbar__action {
        width: 100%;
        justify-content: flex-start;
    }

    .mx-work-main-grid {
        padding: var(--mx-space-3, 0.75rem);
        height: 100%;
    }

    .mx-work-new-mode {
        height: 100%;
        padding: var(--mx-space-3, 0.75rem);
    }

    .mx-work-new-mode__surface {
        display: flex;
        flex-direction: column;
        background: var(--mx-surface, #fff);
        height: 100%;
    }

    .mx-work-new-mode__header {
        display: flex;
        justify-content: space-between;
        padding: var(--mx-space-3, 0.75rem);
    }

    .mx-work-new-mode__title-wrap {
        display: inline-flex;
        flex-direction: column;
        gap: var(--mx-space-1, 0.25rem);
    }

    .mx-work-new-mode__title {
        font-weight: 700;
    }

    .mx-work-new-mode__underline {
        border-bottom: 4px solid currentColor;
        display: block;
        padding: 0.25rem;
    }

    .mx-work-new-mode__content {
        flex: 1;
        overflow: auto;
        padding-inline: var(--mx-space-3, 0.75rem);
        padding-bottom: var(--mx-space-3, 0.75rem);
    }

    .mx-work-new-mode__data {
        display: block;
    }

    .mx-work-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--mx-space-3, 0.75rem);
    }

    .mx-work-new-mode__footer {
        display: flex;
        justify-content: flex-end;
        gap: var(--mx-space-2, 0.5rem);
        padding: var(--mx-space-3, 0.75rem);
    }

    .mx-work-rightbar {
        padding: var(--mx-space-3, 0.75rem);
        height: 100%;
    }

    .mx-work-rightbar__meta {
        display: flex;
        flex-direction: column;
        gap: var(--mx-space-2, 0.5rem);
    }
</style>

@code {
    private const string BrowseMode = "browse";
    private const string DetailMode = "detail";
    private const string EditMode = "edit";
    private const string NewMode = "new";

    private static IReadOnlyList<MxDataGridColumn<WorkItem>> Columns { get; } =
    [
        new("code", "Código", item => item.Code) { IsPrimary = true },
        new("name", "Nombre", item => item.Name),
        new("status", "Estado", item => item.Status),
        new("owner", "Responsable", item => item.Owner),
        new("updated", "Actualizado", item => item.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss")) { Align = "right" }
    ];

    private int Page { get; set; } = 1;
    private string CurrentMode { get; set; } = BrowseMode;
    private string DraftCode { get; set; } = string.Empty;
    private string DraftName { get; set; } = string.Empty;
    private string DraftOwner { get; set; } = string.Empty;
    private IReadOnlyCollection<WorkItem> SelectedItems { get; set; } = Array.Empty<WorkItem>();
    private IReadOnlyList<WorkItem> FilteredItems => WorkSeed.Items;
    private WorkItem? ActiveItem => SelectedItems.FirstOrDefault();
    private bool IsNewMode => CurrentMode == NewMode;
    private bool IsDetailsVisible => !IsNewMode && ActiveItem is not null;
    private bool IsSaveDisabled =>
        string.IsNullOrWhiteSpace(DraftCode) ||
        string.IsNullOrWhiteSpace(DraftName) ||
        string.IsNullOrWhiteSpace(DraftOwner);

    private IReadOnlyList<WorkLeftAction> LeftActions =>
    [
        new(BrowseMode, "Browse", CurrentMode == BrowseMode, false),
        new(DetailMode, "Detail", CurrentMode == DetailMode, ActiveItem is null),
        new(EditMode, "Edit", CurrentMode == EditMode, SelectedItems.Count != 1),
        new(NewMode, "New", CurrentMode == NewMode, false)
    ];

    protected override void OnInitialized()
    {
        SetMode(BrowseMode);
        SyncSelectionWithShell();
    }

    public void Dispose()
    {
        ShellState.ClearWorkSelection();
        ShellState.SetWorkMode(BrowseMode);
    }

    private Task OnPageChanged(int page)
    {
        Page = Math.Max(1, page);
        return Task.CompletedTask;
    }

    private Task OnDraftCodeChanged(string? value)
    {
        DraftCode = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnDraftNameChanged(string? value)
    {
        DraftName = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnDraftOwnerChanged(string? value)
    {
        DraftOwner = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnSelectedItemsChanged(IReadOnlyCollection<WorkItem> selected)
    {
        SelectedItems = selected;
        SyncSelectionWithShell();

        if (ActiveItem is null && (CurrentMode == DetailMode || CurrentMode == EditMode))
        {
            SetMode(BrowseMode);
        }
        else if (ActiveItem is not null && CurrentMode == BrowseMode)
        {
            SetMode(DetailMode);
        }

        return Task.CompletedTask;
    }

    private Task ExecuteLeftAction(string key)
    {
        SetMode(key);
        return Task.CompletedTask;
    }

    private Task CancelEvent()
    {
        ResetDraft();
        SetMode(BrowseMode);
        return Task.CompletedTask;
    }

    private Task SaveEvent()
    {
        ResetDraft();
        SetMode(BrowseMode);
        return Task.CompletedTask;
    }

    private void ResetDraft()
    {
        DraftCode = string.Empty;
        DraftName = string.Empty;
        DraftOwner = string.Empty;
    }

    private void SetMode(string? mode)
    {
        var normalized = NormalizeMode(mode);

        if ((normalized == DetailMode || normalized == EditMode) && ActiveItem is null)
        {
            normalized = BrowseMode;
        }

        if (normalized == NewMode)
        {
            SelectedItems = Array.Empty<WorkItem>();
            SyncSelectionWithShell();
        }

        CurrentMode = normalized;
        ShellState.SetWorkMode(normalized);
    }

    private void SyncSelectionWithShell()
    {
        if (ActiveItem is null)
        {
            ShellState.ClearWorkSelection();
            return;
        }

        ShellState.SetWorkSelection(
            SelectedItems.Count,
            ActiveItem.Name,
            [
                $"Estado: {ActiveItem.Status}",
                $"Responsable: {ActiveItem.Owner}",
                $"Actualizado: {ActiveItem.UpdatedAtUtc.ToLocalTime():dd/MM/yyyy HH:mm:ss}"
            ]);
    }

    private static string NormalizeMode(string? mode)
    {
        var candidate = mode?.Trim().ToLowerInvariant();
        return candidate switch
        {
            NewMode => NewMode,
            DetailMode => DetailMode,
            EditMode => EditMode,
            _ => BrowseMode
        };
    }

    private sealed record WorkLeftAction(string Key, string Label, bool Active, bool Disabled);
    private sealed record WorkItem(string Code, string Name, string Status, string Owner, DateTime UpdatedAtUtc);

    private static class WorkSeed
    {
        public static readonly IReadOnlyList<WorkItem> Items =
        [
            new("WK-1001", "Solicitud de alta de proveedor", "Pendiente", "M. Rivera", DateTime.UtcNow.AddMinutes(-40)),
            new("WK-1002", "Validación de lote contable", "En proceso", "L. Prado", DateTime.UtcNow.AddMinutes(-20)),
            new("WK-1003", "Conciliación bancaria", "Observado", "A. Torres", DateTime.UtcNow.AddMinutes(-10)),
            new("WK-1004", "Aprobación de orden", "Aprobado", "S. Medina", DateTime.UtcNow.AddMinutes(-5))
        ];
    }
}
