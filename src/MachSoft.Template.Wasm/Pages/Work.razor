@page "/work"
@using MachSoft.Template.Wasm.Services
@implements IDisposable
@inject ShellState ShellState

<section class="mx-app-work-shell" aria-label="Superficie de trabajo">
    <header class="mx-app-work-head-block">
        <div class="mx-app-work-head-main">
            <h1 class="mx-app-work-title">Operaciones</h1>
            <p class="mx-app-work-toolbar-caption">@CurrentModeLabel · @SelectionCountLabel</p>
        </div>
        <div class="mx-app-work-head-context">
            <span class="mx-app-work-context-badge">En curso</span>
            <p>@SelectionSummary</p>
        </div>
    </header>

    <div class="mx-app-work-toolbar" role="toolbar" aria-label="Barra de acciones">
        <div class="mx-app-work-toolbar-actions">
            <MxButton Label="Actualizar"
                      Variant="MxVariant.Outlined"
                      Tone="MxTone.Neutral"
                      Size="MxSize.Small"
                      OnClick="_ => RefreshList()" />
            <MxButton Label="Listado"
                      Variant="@(CurrentMode == BrowseMode ? MxVariant.Filled : MxVariant.Outlined)"
                      Tone="MxTone.Neutral"
                      Size="MxSize.Small"
                      OnClick="_ => SetMode(BrowseMode)" />
            <MxButton Label="Abrir"
                      Variant="@(CurrentMode == DetailMode ? MxVariant.Filled : MxVariant.Outlined)"
                      Tone="MxTone.Primary"
                      Size="MxSize.Small"
                      Disabled="@(!ShellState.WorkSelectionActive)"
                      OnClick="_ => SetMode(DetailMode)" />
            <MxButton Label="Editar"
                      Variant="@(CurrentMode == EditMode ? MxVariant.Filled : MxVariant.Outlined)"
                      Tone="MxTone.Primary"
                      Size="MxSize.Small"
                      Disabled="@(!ShellState.WorkSelectionActive)"
                      OnClick="_ => SetMode(EditMode)" />
            <MxButton Label="Crear"
                      Variant="@(CurrentMode == NewMode ? MxVariant.Filled : MxVariant.Outlined)"
                      Tone="MxTone.Secondary"
                      Size="MxSize.Small"
                      OnClick="_ => SetMode(NewMode)" />
        </div>
        <div class="mx-app-work-toolbar-meta">
            <span>@FilteredItems.Count registros</span>
            <span aria-hidden="true">•</span>
            <span>@SelectionCountLabel</span>
            <span aria-hidden="true">•</span>
            <span>Página @Page</span>
        </div>
    </div>

    @if (CurrentMode == NewMode)
    {
        <section class="mx-app-work-state-panel" aria-label="Bloque de alta">
            <header>
                <h2>Alta rápida</h2>
                <p>Completa los datos base y confirma para continuar en el listado.</p>
            </header>
            <div class="mx-app-work-state-grid">
                <label>
                    Código
                    <input type="text" placeholder="WK-10XX" />
                </label>
                <label>
                    Nombre
                    <input type="text" placeholder="Descripción de tarea" />
                </label>
                <label>
                    Responsable
                    <input type="text" placeholder="Nombre de responsable" />
                </label>
            </div>
            <div class="mx-app-work-state-actions">
                <MxButton Label="Cancelar" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" Size="MxSize.Small" OnClick="_ => SetMode(BrowseMode)" />
                <MxButton Label="Guardar" Variant="MxVariant.Filled" Tone="MxTone.Primary" Size="MxSize.Small" OnClick="_ => SetMode(BrowseMode)" />
            </div>
        </section>
    }

    <div class="mx-app-work-surface">
        <div class="mx-app-work-grid-shell">
            <MxDataGrid TItem="WorkItem"
                        Items="@FilteredItems"
                        Columns="@Columns"
                        SearchEnabled="false"
                        UsePagination="true"
                        CurrentPage="@Page"
                        CurrentPageChanged="@OnPageChanged"
                        PageSize="10"
                        Selectable="true"
                        SelectedItems="@SelectedItems"
                        SelectedItemsChanged="@OnSelectedItemsChanged" />
        </div>
    </div>
</section>

@code {
    private const string BrowseMode = "browse";
    private const string DetailMode = "detail";
    private const string EditMode = "edit";
    private const string NewMode = "new";

    private int Page = 1;
    private string CurrentMode { get; set; } = BrowseMode;
    private string CurrentModeLabel => CurrentMode switch
    {
        NewMode => "Nuevo",
        DetailMode => "Detalle",
        EditMode => "Edición",
        _ => "Listado"
    };

    private string SelectionSummary => ShellState.WorkSelectionActive
        ? $"{ShellState.WorkSelectionCount} elemento(s) en foco"
        : "Sin selección";

    private string SelectionCountLabel => ShellState.WorkSelectionActive
        ? $"{ShellState.WorkSelectionCount} seleccionados"
        : "0 seleccionados";

    private IReadOnlyCollection<WorkItem> SelectedItems { get; set; } = Array.Empty<WorkItem>();

    private static IReadOnlyList<MxDataGridColumn<WorkItem>> Columns { get; } =
    [
        new("code", "Código", item => item.Code) { IsPrimary = true },
        new("name", "Nombre", item => item.Name),
        new("status", "Estado", item => item.Status),
        new("owner", "Responsable", item => item.Owner),
        new("updated", "Actualizado", item => item.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss")) { Align = "right" }
    ];

    private IReadOnlyList<WorkItem> FilteredItems => WorkSeed.Items;

    protected override void OnInitialized()
    {
        SelectedItems = Array.Empty<WorkItem>();
        ShellState.Changed += OnShellStateChanged;
        ShellState.ClearWorkSelection();
        SetMode(BrowseMode, syncShell: true);
    }

    public void Dispose()
    {
        ShellState.Changed -= OnShellStateChanged;
        ShellState.ClearWorkSelection();
        ShellState.SetWorkMode(BrowseMode);
    }

    private Task OnPageChanged(int page)
    {
        Page = page;
        return Task.CompletedTask;
    }

    private Task OnSelectedItemsChanged(IReadOnlyCollection<WorkItem> selected)
    {
        SelectedItems = selected;

        var first = selected.FirstOrDefault();
        var details = first is null
            ? Array.Empty<string>()
            :
            [
                $"Estado: {first.Status}",
                $"Responsable: {first.Owner}",
                $"Actualizado: {first.UpdatedAtUtc.ToLocalTime():dd/MM/yyyy HH:mm:ss}"
            ];

        ShellState.SetWorkSelection(selected.Count, first?.Name, details);

        if (selected.Count == 0 && (CurrentMode == DetailMode || CurrentMode == EditMode))
        {
            SetMode(BrowseMode);
        }
        else if (selected.Count > 0 && CurrentMode == BrowseMode)
        {
            SetMode(DetailMode);
        }

        return Task.CompletedTask;
    }

    private Task RefreshList()
    {
        Page = 1;
        return Task.CompletedTask;
    }

    private void SetMode(string mode, bool syncShell = true)
    {
        var normalized = NormalizeMode(mode);

        if ((normalized == DetailMode || normalized == EditMode) && !ShellState.WorkSelectionActive)
        {
            normalized = BrowseMode;
        }

        if (normalized == NewMode)
        {
            SelectedItems = Array.Empty<WorkItem>();
            ShellState.ClearWorkSelection();
        }

        CurrentMode = normalized;

        if (syncShell)
        {
            ShellState.SetWorkMode(normalized);
        }
    }

    private void OnShellStateChanged()
    {
        if (!string.Equals(CurrentMode, ShellState.WorkMode, StringComparison.OrdinalIgnoreCase))
        {
            SetMode(ShellState.WorkMode, syncShell: false);
        }

        InvokeAsync(StateHasChanged);
    }

    private static string NormalizeMode(string mode)
    {
        return mode.ToLowerInvariant() switch
        {
            NewMode => NewMode,
            DetailMode => DetailMode,
            EditMode => EditMode,
            _ => BrowseMode
        };
    }
}
