@using Microsoft.JSInterop
@using MachSoft.UI.Showcase.Models
@inject IJSRuntime JS
@inject ShowcaseThemeState ThemeState
@implements IDisposable

<MxThemeProvider DarkMode="@ThemeState.IsDarkMode">
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <MxPageContainer FullWidth="true" Title="Ruta no encontrada">
                    <MxSectionCard>
                        <MudText Typo="Typo.body1">La ruta solicitada no existe en el catálogo.</MudText>
                    </MxSectionCard>
                </MxPageContainer>
            </LayoutView>
        </NotFound>
    </Router>
</MxThemeProvider>

@code {
    protected override async Task OnInitializedAsync()
    {
        ThemeState.Changed += OnThemeChanged;
        var persisted = await JS.InvokeAsync<string?>("localStorage.getItem", "mx-showcase-theme");
        ThemeState.Set(string.Equals(persisted, "dark", StringComparison.OrdinalIgnoreCase));
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
