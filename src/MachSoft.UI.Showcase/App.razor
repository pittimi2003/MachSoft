@using MachSoft.UI.Showcase.Theme
@implements IDisposable

<CascadingValue Value="_themeState">
    <MxThemeProvider DarkMode="@_themeState.DarkMode">
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />
        <Router AppAssembly="typeof(App).Assembly">
            <Found Context="routeData">
                <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(Layout.MainLayout)">
                    <MxPageContainer FullWidth="true">
                        <MxSectionCard Title="Ruta no encontrada">
                            <p>La ruta solicitada no existe en este showcase.</p>
                        </MxSectionCard>
                    </MxPageContainer>
                </LayoutView>
            </NotFound>
        </Router>
    </MxThemeProvider>
</CascadingValue>

@code {
    private readonly ShowcaseThemeState _themeState = new();

    protected override void OnInitialized()
    {
        _themeState.OnChange += OnThemeChanged;
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _themeState.OnChange -= OnThemeChanged;
    }
}
