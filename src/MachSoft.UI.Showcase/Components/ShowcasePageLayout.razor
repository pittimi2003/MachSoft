<MxPageContainer FullWidth="@FullWidth"
                 Class="@ContainerClass"
                 Title="@Title"
                 Subtitle="@Subtitle">
    <div class="mx-showcase-page-frame">
        @if (HeaderContent is not null)
        {
            <section class="mx-showcase-page-header-region" aria-label="Encabezado de página">
                @HeaderContent
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Summary))
        {
            <section class="mx-showcase-page-summary" aria-label="Resumen de página">
                <p>@Summary</p>
            </section>
        }

        <section class="mx-showcase-page-main @(ContextContent is null ? "mx-showcase-page-main-single" : string.Empty)">
            <div class="mx-showcase-page-primary">
                @ChildContent
            </div>

            @if (ContextContent is not null)
            {
                <aside class="mx-showcase-page-context" aria-label="Contexto de la página">
                    @ContextContent
                </aside>
            }
        </section>
    </div>
</MxPageContainer>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string Summary { get; set; } = string.Empty;
    [Parameter] public bool FullWidth { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ContextContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ContainerClass => string.IsNullOrWhiteSpace(Class) ? "mx-showcase-page" : $"mx-showcase-page {Class}";
}
