@inherits LayoutComponentBase
@using MachSoft.UI.Showcase.Theme
@using Microsoft.JSInterop
@inject IJSRuntime JS

<MxWorkspaceLayout MainMenuOpen="@MainMenuOpen"
                   MainMenuOpenChanged="@OnMainMenuOpenChanged"
                   NavigationMenuMode="MxSidebarMode.Overlay"
                   LeftSidebarMode="@LeftSidebarMode"
                   LeftSidebarModeChanged="@OnLeftSidebarModeChanged"
                   RightSidebarMode="@RightSidebarMode"
                   RightSidebarModeChanged="@OnRightSidebarModeChanged"
                   LeftSidebarOpen="@LeftSidebarOpen"
                   LeftSidebarOpenChanged="@OnLeftSidebarOpenChanged"
                   RightSidebarOpen="@RightSidebarOpen"
                   RightSidebarOpenChanged="@OnRightSidebarOpenChanged"
                   LeftSidebarWidth="280px"
                   RightSidebarWidth="320px"
                   OnBackdropClick="@CloseAllOverlays">

    <HeaderContent>
        <div class="showcase-topbar">
            <div class="showcase-brand">
                <span class="showcase-brand-mark" aria-hidden="true">Mx</span>
                <div>
                    <strong>MachSoft UI Showcase</strong>
                    <div class="showcase-brand-sub">Host oficial de demostración</div>
                </div>
            </div>

            <MxTooltip Text="@ThemeTooltip">
                <MxIconButton Class="mx-theme-toggle"
                              Icon="@ThemeIcon"
                              AriaLabel="@ThemeTooltip"
                              Title="@ThemeTooltip"
                              Tone="MxTone.Neutral"
                              OnClick="_ => ToggleThemeAsync()" />
            </MxTooltip>
        </div>
    </HeaderContent>

    <NavigationMenu>
        <NavMenu />
    </NavigationMenu>

    <LeftSidebar>
        <div class="showcase-sidebar">
            <h4>Quick actions</h4>
            <MxButton Tone="MxTone.Primary" Size="MxSize.Small">Nuevo ejemplo</MxButton>
            <MxButton Tone="MxTone.Neutral" Variant="MxVariant.Outlined" Size="MxSize.Small">Reset filtros</MxButton>
            <p>Panel secundario para acciones operativas del host.</p>
        </div>
    </LeftSidebar>

    <MainContent>
        @Body
    </MainContent>

    <RightSidebar>
        <div class="showcase-sidebar">
            <h4>Contexto</h4>
            <p>Notas de auditoría visual y estado del host.</p>
            <ul>
                <li>Menu: @(MainMenuOpen ? "abierto" : "cerrado")</li>
                <li>Left: @(LeftSidebarOpen ? "abierto" : "cerrado")</li>
                <li>Right: @(RightSidebarOpen ? "abierto" : "cerrado")</li>
            </ul>
        </div>
    </RightSidebar>

    <FooterContent>
        <div class="showcase-footer">MainLayout único · MxWorkspaceLayout · sidebars secundarios</div>
    </FooterContent>
</MxWorkspaceLayout>

@code {
    [CascadingParameter] public ShowcaseThemeState ThemeState { get; set; } = default!;

    private bool MainMenuOpen { get; set; }
    private bool LeftSidebarOpen { get; set; }
    private bool RightSidebarOpen { get; set; }
    private MxSidebarMode LeftSidebarMode { get; set; } = MxSidebarMode.Overlay;
    private MxSidebarMode RightSidebarMode { get; set; } = MxSidebarMode.Overlay;

    private string ThemeIcon => ThemeState.DarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;
    private string ThemeTooltip => ThemeState.DarkMode ? "Cambiar a tema claro" : "Cambiar a tema oscuro";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeState.InitializeAsync(JS);
        }
    }

    private Task ToggleThemeAsync() => ThemeState.ToggleAsync(JS);

    private Task OnMainMenuOpenChanged(bool isOpen)
    {
        MainMenuOpen = isOpen;
        return Task.CompletedTask;
    }

    private Task OnLeftSidebarOpenChanged(bool isOpen)
    {
        LeftSidebarOpen = isOpen;
        return Task.CompletedTask;
    }

    private Task OnRightSidebarOpenChanged(bool isOpen)
    {
        RightSidebarOpen = isOpen;
        return Task.CompletedTask;
    }

    private Task OnLeftSidebarModeChanged(MxSidebarMode mode)
    {
        LeftSidebarMode = mode;
        return Task.CompletedTask;
    }

    private Task OnRightSidebarModeChanged(MxSidebarMode mode)
    {
        RightSidebarMode = mode;
        return Task.CompletedTask;
    }

    private Task CloseAllOverlays()
    {
        MainMenuOpen = false;
        LeftSidebarOpen = false;
        RightSidebarOpen = false;
        return Task.CompletedTask;
    }
}
