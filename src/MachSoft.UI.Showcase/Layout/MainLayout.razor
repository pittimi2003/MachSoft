@inherits LayoutComponentBase
@using MachSoft.UI.Showcase.Theme
@using Microsoft.JSInterop
@inject IJSRuntime JS

<MxWorkspaceLayout LeftSidebarVisible="@MainMenuOpen"
                   RightSidebarVisible="@RightSidebarVisible"
                   LeftSidebarMode="@LeftSidebarMode"
                   RightSidebarMode="@RightSidebarMode"
                   LeftSidebarWidth="306px"
                   RightSidebarWidth="360px"
                   MainMenuOpen="@MainMenuOpen"
                   MainMenuOpenChanged="@OnMainMenuOpenChanged"
                   OnBackdropClick="@OnBackdropClick">
    <HeaderContent>
        <div class="mx-showcase-topbar">
            <div class="mx-showcase-brand-wrap">
                <span class="mx-showcase-brand-mark" aria-hidden="true">MS</span>
                <div class="mx-showcase-brand-block">
                    <span class="mx-showcase-brand">MachSoft UI Showcase</span>
                    <span class="mx-showcase-brand-subtitle">Plataforma visual enterprise</span>
                </div>
            </div>
            <MxTooltip Text="@ThemeTooltip">
                <MxIconButton
                    Icon="@ThemeIcon"
                    AriaLabel="@ThemeAriaLabel"
                    Title="@ThemeTooltip"
                    Tone="MxTone.Neutral"
                    Class="mx-theme-toggle"
                    OnClick="_ => ToggleThemeAsync()" />
            </MxTooltip>
        </div>
    </HeaderContent>

    <LeftSidebar>
        <nav class="mx-workspace-nav" aria-label="Menú principal showcase">
            <p class="mx-workspace-nav-group-title">Overview</p>
            <NavLink Match="NavLinkMatch.All" class="mx-workspace-nav-link" href="/">Home</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/catalog/audit">Catalog / Audit Matrix</NavLink>

            <p class="mx-workspace-nav-group-title">Foundations</p>
            <NavLink class="mx-workspace-nav-link" href="/foundations/colors">Foundations / Colors</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/foundations/typography">Foundations / Typography</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/foundations/spacing">Foundations / Spacing</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/foundations/radius-elevation">Foundations / Radius & Elevation</NavLink>

            <p class="mx-workspace-nav-group-title">Components</p>
            <NavLink class="mx-workspace-nav-link" href="/components/buttons">Components / Buttons</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/components/forms">Inputs / Advanced Inputs</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/components/dialogs">Dialogs</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/components/navigation">Navigation</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/components/data-listing">Data Listing</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/components/feedback">Feedback</NavLink>

            <p class="mx-workspace-nav-group-title">Patterns & states</p>
            <NavLink class="mx-workspace-nav-link" href="/patterns/crud">Patterns / CRUD</NavLink>
            <NavLink class="mx-workspace-nav-link" href="/states/feedback">States</NavLink>
        </nav>
    </LeftSidebar>

    <MainContent>
        @Body
    </MainContent>

    <RightSidebar>
        <div class="mx-workspace-panel">
            <h4>Shell controls</h4>
            <MxSwitch Label="Panel derecho visible" Value="@RightSidebarVisible" ValueChanged="@OnRightSidebarVisibleChanged" />
            <MxSwitch Label="Sidebar izquierdo inline" Value="@LeftInline" ValueChanged="@OnLeftInlineChanged" />
            <MxSwitch Label="Sidebar derecho inline" Value="@RightInline" ValueChanged="@OnRightInlineChanged" />
            <p class="mx-page-subtitle">Este panel demuestra que el shell es declarativo: solo cambiamos estado, sin lógica de layout en el host.</p>
        </div>
    </RightSidebar>

    <FooterContent>
        <div class="mx-workspace-footer-meta">
            <span>Shell oficial: <strong>MxWorkspaceLayout</strong></span>
            <span>Left: @LeftSidebarMode | Right: @RightSidebarMode | Menú: @(MainMenuOpen ? "Abierto" : "Cerrado")</span>
        </div>
    </FooterContent>
</MxWorkspaceLayout>

@code {
    [CascadingParameter] public ShowcaseThemeState ThemeState { get; set; } = default!;

    private bool MainMenuOpen { get; set; }
    private bool RightSidebarVisible { get; set; } = true;
    private MxSidebarMode LeftSidebarMode { get; set; } = MxSidebarMode.Overlay;
    private MxSidebarMode RightSidebarMode { get; set; } = MxSidebarMode.Inline;

    private bool LeftInline => LeftSidebarMode == MxSidebarMode.Inline;
    private bool RightInline => RightSidebarMode == MxSidebarMode.Inline;

    private string ThemeIcon => ThemeState.DarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;
    private string ThemeTooltip => ThemeState.DarkMode ? "Cambiar a tema claro" : "Cambiar a tema oscuro";
    private string ThemeAriaLabel => ThemeState.DarkMode ? "Activar tema claro" : "Activar tema oscuro";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeState.InitializeAsync(JS);
    }

    private Task ToggleThemeAsync() => ThemeState.ToggleAsync(JS);

    private Task OnMainMenuOpenChanged(bool isOpen)
    {
        MainMenuOpen = isOpen;
        return Task.CompletedTask;
    }


    private Task OnBackdropClick()
    {
        MainMenuOpen = false;
        return Task.CompletedTask;
    }

    private Task OnRightSidebarVisibleChanged(bool isVisible)
    {
        RightSidebarVisible = isVisible;
        return Task.CompletedTask;
    }

    private Task OnLeftInlineChanged(bool isInline)
    {
        LeftSidebarMode = isInline ? MxSidebarMode.Inline : MxSidebarMode.Overlay;
        return Task.CompletedTask;
    }

    private Task OnRightInlineChanged(bool isInline)
    {
        RightSidebarMode = isInline ? MxSidebarMode.Inline : MxSidebarMode.Overlay;
        return Task.CompletedTask;
    }
}
