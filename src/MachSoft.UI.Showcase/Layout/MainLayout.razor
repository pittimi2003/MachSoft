@inherits LayoutComponentBase
@using MachSoft.UI.Showcase.Models
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ShowcaseThemeState ThemeState

<MxWorkspaceLayout MainMenuOpen="@MainMenuOpen"
                   MainMenuOpenChanged="@OnMainMenuOpenChanged"
                   NavigationMenuMode="MxSidebarMode.Overlay"
                   LeftSidebarMode="@LeftSidebarMode"
                   LeftSidebarModeChanged="@OnLeftSidebarModeChanged"
                   RightSidebarMode="@RightSidebarMode"
                   RightSidebarModeChanged="@OnRightSidebarModeChanged"
                   LeftSidebarOpen="@LeftSidebarOpen"
                   LeftSidebarOpenChanged="@OnLeftSidebarOpenChanged"
                   RightSidebarOpen="@RightSidebarOpen"
                   RightSidebarOpenChanged="@OnRightSidebarOpenChanged">
    <HeaderContent>
        <div class="showcase-header-content">
            <div class="showcase-brand">
                <span class="showcase-brand-title">MachSoft UI Platform</span>
                <span class="showcase-brand-subtitle">Catálogo auditable de componentes Mx*</span>
            </div>
            <MxMenu Label="Controles"
                    Icon="@Icons.Material.Outlined.Tune"
                    Tone="MxTone.Neutral"
                    Items="@GlobalControlItems"
                    OnItemSelected="OnControlSelectedAsync" />
            <button class="mx-theme-toggle"
                    title="@(ThemeState.IsDarkMode ? "Cambiar a tema claro" : "Cambiar a tema oscuro")"
                    @onclick="ToggleThemeAsync">
                @(ThemeState.IsDarkMode ? "☀️ Light" : "🌙 Dark")
            </button>
        </div>
    </HeaderContent>

    <NavigationMenu>
        <NavMenu />
    </NavigationMenu>

    <LeftSidebar>
        <div class="showcase-sidebar">
            <strong>Left Sidebar</strong>
            <span>Modo: @LeftSidebarMode</span>
            <span>Abierto: @LeftSidebarOpen</span>
        </div>
    </LeftSidebar>

    <MainContent>
        @Body
    </MainContent>

    <RightSidebar>
        <div class="showcase-sidebar">
            <strong>Right Sidebar</strong>
            <span>Modo: @RightSidebarMode</span>
            <span>Abierto: @RightSidebarOpen</span>
        </div>
    </RightSidebar>
</MxWorkspaceLayout>

@code {
    private const string NavigationMenuToggleKey = "nav.toggle";
    private const string LeftModeInlineKey = "left.mode.inline";
    private const string LeftModeOverlayKey = "left.mode.overlay";
    private const string LeftOpenToggleKey = "left.open.toggle";
    private const string RightModeInlineKey = "right.mode.inline";
    private const string RightModeOverlayKey = "right.mode.overlay";
    private const string RightOpenToggleKey = "right.open.toggle";

    private bool MainMenuOpen { get; set; }
    private MxSidebarMode LeftSidebarMode { get; set; } = MxSidebarMode.Overlay;
    private MxSidebarMode RightSidebarMode { get; set; } = MxSidebarMode.Overlay;
    private bool LeftSidebarOpen { get; set; }
    private bool RightSidebarOpen { get; set; }

    private IReadOnlyList<MxMenuItem> GlobalControlItems =>
    [
        new(NavigationMenuToggleKey, MainMenuOpen ? "NavigationMenu: Cerrar" : "NavigationMenu: Abrir", Icons.Material.Outlined.Menu),
        new(LeftModeInlineKey, LeftSidebarMode == MxSidebarMode.Inline ? "LeftSidebar: Inline ✓" : "LeftSidebar: Inline", Icons.Material.Outlined.ViewWeek),
        new(LeftModeOverlayKey, LeftSidebarMode == MxSidebarMode.Overlay ? "LeftSidebar: Overlay ✓" : "LeftSidebar: Overlay", Icons.Material.Outlined.Layers),
        new(LeftOpenToggleKey, LeftSidebarOpen ? "LeftSidebar: Cerrar overlay" : "LeftSidebar: Abrir overlay", Icons.Material.Outlined.ChevronLeft, LeftSidebarMode == MxSidebarMode.Inline),
        new(RightModeInlineKey, RightSidebarMode == MxSidebarMode.Inline ? "RightSidebar: Inline ✓" : "RightSidebar: Inline", Icons.Material.Outlined.ViewWeek),
        new(RightModeOverlayKey, RightSidebarMode == MxSidebarMode.Overlay ? "RightSidebar: Overlay ✓" : "RightSidebar: Overlay", Icons.Material.Outlined.Layers),
        new(RightOpenToggleKey, RightSidebarOpen ? "RightSidebar: Cerrar overlay" : "RightSidebar: Abrir overlay", Icons.Material.Outlined.ChevronRight, RightSidebarMode == MxSidebarMode.Inline)
    ];

    private Task OnMainMenuOpenChanged(bool next)
    {
        MainMenuOpen = next;
        return Task.CompletedTask;
    }

    private Task OnLeftSidebarModeChanged(MxSidebarMode next)
    {
        LeftSidebarMode = next;
        if (next == MxSidebarMode.Inline)
        {
            LeftSidebarOpen = false;
        }

        return Task.CompletedTask;
    }

    private Task OnRightSidebarModeChanged(MxSidebarMode next)
    {
        RightSidebarMode = next;
        if (next == MxSidebarMode.Inline)
        {
            RightSidebarOpen = false;
        }

        return Task.CompletedTask;
    }

    private Task OnLeftSidebarOpenChanged(bool next)
    {
        LeftSidebarOpen = next;
        return Task.CompletedTask;
    }

    private Task OnRightSidebarOpenChanged(bool next)
    {
        RightSidebarOpen = next;
        return Task.CompletedTask;
    }

    private async Task ToggleThemeAsync()
    {
        ThemeState.Set(!ThemeState.IsDarkMode);
        await JS.InvokeVoidAsync("localStorage.setItem", "mx-showcase-theme", ThemeState.IsDarkMode ? "dark" : "light");
    }

    private Task OnControlSelectedAsync(string key)
    {
        switch (key)
        {
            case NavigationMenuToggleKey:
                MainMenuOpen = !MainMenuOpen;
                break;
            case LeftModeInlineKey:
                LeftSidebarMode = MxSidebarMode.Inline;
                LeftSidebarOpen = false;
                break;
            case LeftModeOverlayKey:
                LeftSidebarMode = MxSidebarMode.Overlay;
                break;
            case LeftOpenToggleKey when LeftSidebarMode == MxSidebarMode.Overlay:
                LeftSidebarOpen = !LeftSidebarOpen;
                break;
            case RightModeInlineKey:
                RightSidebarMode = MxSidebarMode.Inline;
                RightSidebarOpen = false;
                break;
            case RightModeOverlayKey:
                RightSidebarMode = MxSidebarMode.Overlay;
                break;
            case RightOpenToggleKey when RightSidebarMode == MxSidebarMode.Overlay:
                RightSidebarOpen = !RightSidebarOpen;
                break;
        }

        return Task.CompletedTask;
    }
}
