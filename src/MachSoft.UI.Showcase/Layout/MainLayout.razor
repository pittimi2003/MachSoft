@inherits LayoutComponentBase
@using MachSoft.UI.Showcase.Theme

<MudLayout Class="mx-showcase-shell">
    <MudAppBar Elevation="0">
        <div class="mx-showcase-topbar">
            <span class="mx-showcase-brand">MachSoft UI Showcase</span>
            <MxTooltip Text="Cambiar tema oficial MachSoft (light/dark)">
                <MxIconButton Icon="@ThemeIcon" AriaLabel="Cambiar tema" Tone="MxTone.Neutral" OnClick="_ => ToggleTheme()" />
            </MxTooltip>
        </div>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" ClipMode="DrawerClipMode.Always" Width="290px">
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All" Href="/">Home</MudNavLink>
            <MudNavLink Href="/foundations/colors">Foundations / Colors</MudNavLink>
            <MudNavLink Href="/foundations/typography">Foundations / Typography</MudNavLink>
            <MudNavLink Href="/foundations/spacing">Foundations / Spacing</MudNavLink>
            <MudNavLink Href="/foundations/radius-elevation">Foundations / Radius & Elevation</MudNavLink>
            <MudNavLink Href="/components/buttons">Components / Buttons</MudNavLink>
            <MudNavLink Href="/components/forms">Components / Forms</MudNavLink>
            <MudNavLink Href="/components/dialogs">Components / Dialogs</MudNavLink>
            <MudNavLink Href="/patterns/crud">Patterns / CRUD</MudNavLink>
            <MudNavLink Href="/states/feedback">States</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] public ShowcaseThemeState ThemeState { get; set; } = default!;

    private string ThemeIcon => ThemeState.DarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;

    private void ToggleTheme()
    {
        ThemeState.Toggle();
        StateHasChanged();
    }
}
