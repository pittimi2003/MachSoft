@inherits LayoutComponentBase
@using MachSoft.UI.Showcase.Theme
@using Microsoft.JSInterop
@inject IJSRuntime JS

<MudLayout Class="mx-showcase-shell">
    <MudAppBar Elevation="0" Dense="true">
        <div class="mx-showcase-topbar">
            <div class="mx-showcase-brand-wrap">
                <span class="mx-showcase-brand-mark" aria-hidden="true">MS</span>
                <div class="mx-showcase-brand-block">
                    <span class="mx-showcase-brand">MachSoft UI Showcase</span>
                    <span class="mx-showcase-brand-subtitle">Plataforma visual enterprise</span>
                </div>
            </div>
            <MxTooltip Text="@ThemeTooltip">
                <MxIconButton
                    Icon="@ThemeIcon"
                    AriaLabel="@ThemeAriaLabel"
                    Title="@ThemeTooltip"
                    Tone="MxTone.Neutral"
                    Class="mx-theme-toggle"
                    OnClick="_ => ToggleThemeAsync()" />
            </MxTooltip>
        </div>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" ClipMode="DrawerClipMode.Always" Width="306px">
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All" Href="/">Home</MudNavLink>
            <MudNavLink Href="/foundations/colors">Foundations / Colors</MudNavLink>
            <MudNavLink Href="/foundations/typography">Foundations / Typography</MudNavLink>
            <MudNavLink Href="/foundations/spacing">Foundations / Spacing</MudNavLink>
            <MudNavLink Href="/foundations/radius-elevation">Foundations / Radius & Elevation</MudNavLink>
            <MudNavLink Href="/components/buttons">Components / Buttons</MudNavLink>
            <MudNavLink Href="/components/forms">Components / Forms</MudNavLink>
            <MudNavLink Href="/components/dialogs">Components / Dialogs</MudNavLink>
            <MudNavLink Href="/patterns/crud">Patterns / CRUD</MudNavLink>
            <MudNavLink Href="/states/feedback">States</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter] public ShowcaseThemeState ThemeState { get; set; } = default!;

    private string ThemeIcon => ThemeState.DarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode;
    private string ThemeTooltip => ThemeState.DarkMode ? "Cambiar a tema claro" : "Cambiar a tema oscuro";
    private string ThemeAriaLabel => ThemeState.DarkMode ? "Activar tema claro" : "Activar tema oscuro";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeState.InitializeAsync(JS);
    }

    private Task ToggleThemeAsync() => ThemeState.ToggleAsync(JS);
}
