@page "/catalog/audit"

<MxPageContainer Title="Catalog / Audit Matrix" Subtitle="Inventario contractual de controles, familias, variantes y estados auditables del catálogo MachSoft.">
  <MudStack Spacing="3">
    <MxSectionCard Title="Cobertura por familias">
      <table class="mx-catalog-table">
        <thead>
          <tr>
            <th>Familia</th>
            <th>Controles oficiales</th>
            <th>Estados/variantes auditables</th>
            <th>Showcase</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in _rows)
          {
            <tr>
              <td class="mx-datagrid-primary">@row.Family</td>
              <td>@row.Controls</td>
              <td>@row.Coverage</td>
              <td><a href="@row.Url">@row.Page</a></td>
            </tr>
          }
        </tbody>
      </table>
    </MxSectionCard>

    <MxSectionCard Title="Checklist de cierre del catálogo">
      <ul>
        <li>MxDataGrid: toolbar, búsqueda, filtros rápidos/avanzados, ordenamiento, selección, estados y paginación real.</li>
        <li>MxFileUpload: drag-and-drop en superficie, validación, remove, disabled y estado de carga/progreso.</li>
        <li>Buttons: matriz exhaustiva de variantes, tamaños, iconografía, loading y link mode.</li>
        <li>Cobertura visual light/dark mediante toggle global y páginas por familias.</li>
      </ul>
    </MxSectionCard>
  </MudStack>
</MxPageContainer>

@code {
  private readonly IReadOnlyList<CatalogRow> _rows =
  [
    new("Buttons", "MxButton, MxIconButton", "normal, hover, focus, active, disabled, loading, icon-left/right/only, size S/M/L", "/components/buttons", "Components / Buttons"),
    new("Forms", "MxTextField, MxTextArea, MxSelect, MxCheckbox, MxRadio, MxRadioGroup, MxSwitch", "normal, invalid, disabled + caso de uso", "/components/forms", "Components / Forms"),
    new("Advanced Inputs", "MxAutocomplete, MxMultiSelect, MxDatePicker, MxDateRangePicker, MxFileUpload", "idle, dragover, selected, error, disabled, uploading", "/components/forms", "Components / Forms"),
    new("Navigation", "MxMenu, MxTabs, MxBreadcrumb, MxNav*", "selected, hover, icon integration", "/components/navigation", "Components / Navigation"),
    new("Dialogs", "MxDialog, MxConfirmDialog", "open/close, confirm/cancel", "/components/dialogs", "Components / Dialogs"),
    new("Feedback", "MxAlert, MxSnackbar, MxProgress, MxSkeleton, MxBusyOverlay, MxEmptyState, MxLoadingState, MxErrorState", "info/success/warning/error + loading + empty/error states", "/components/feedback", "Components / Feedback"),
    new("DataGrid / Listing", "MxDataGrid, MxPaginator, MxCrudToolbar, MxFilterBar, MxEntityHeader", "sorting, select, empty/loading/error, paginación + CRUD composition", "/components/data-listing", "Data Listing"),
    new("States", "MxEmptyState, MxLoadingState, MxErrorState", "state governance + feedback", "/states/feedback", "States / Feedback"),
    new("Patterns", "CRUD composition", "entity header + toolbar + filters + grid + confirm", "/patterns/crud", "Patterns / CRUD")
  ];

  private sealed record CatalogRow(string Family, string Controls, string Coverage, string Url, string Page);
}
