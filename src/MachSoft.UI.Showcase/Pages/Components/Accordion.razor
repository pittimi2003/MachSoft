@page "/components/accordion"

<MxPageContainer FullWidth="true" Title="Accordion" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxAccordion</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxAccordion Title="Panel principal">
  <MudText Typo="Typo.body2">Contenido expandible del componente.</MudText>
</MxAccordion>
<MxAccordion Title="Panel secundario" Expanded="true">
  <MudText Typo="Typo.body2">Arranca abierto para estado alterno.</MudText>
</MxAccordion>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

