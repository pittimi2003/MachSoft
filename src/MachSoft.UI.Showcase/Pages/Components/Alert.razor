@page "/components/alert"

<MxPageContainer FullWidth="true" Title="Alert" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxAlert</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxAlert Tone="MxAlertTone.Info" Title="Info" Description="Mensaje informativo" />
<MxAlert Tone="MxAlertTone.Success" Title="Éxito" Description="Operación completada" />
<MxAlert Tone="MxAlertTone.Warning" Title="Advertencia" Description="Revisa los datos" />
<MxAlert Tone="MxAlertTone.Error" Title="Error" Description="No se pudo guardar" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

