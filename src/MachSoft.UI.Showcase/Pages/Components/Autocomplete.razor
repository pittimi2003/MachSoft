@page "/components/autocomplete"

<MxPageContainer FullWidth="true" Title="Autocomplete" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxAutocomplete</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxAutocomplete Label="Ciudad" Options="@_cities" Value="@_city" ValueChanged="v => _city = v" Placeholder="Escribe para buscar" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private readonly IReadOnlyList<string> _cities = ["Bogotá", "Ciudad de México", "Lima", "Santiago", "Madrid"];
    private string? _city;
}
