@page "/components/buttons"

<MxPageContainer FullWidth="true" Class="showcase-page">
    <section class="showcase-hero">
        <p class="showcase-kicker">Components</p>
        <h1>Buttons auditables: variantes, estados, tamaños e iconografía</h1>
    </section>

    <MxSectionCard Title="Variantes contractuales" Class="showcase-section">
        <div class="buttons-row">
            <MxButton Tone="MxTone.Primary">Primary</MxButton>
            <MxButton Tone="MxTone.Neutral">Neutral</MxButton>
            <MxButton Tone="MxTone.Neutral" Variant="MxVariant.Outlined">Outlined</MxButton>
            <MxButton Tone="MxTone.Neutral" Variant="MxVariant.Text">Text</MxButton>
        </div>
    </MxSectionCard>

    <MxSectionCard Title="Estados" Class="showcase-section">
        <div class="buttons-row">
            <MxButton Tone="MxTone.Primary">Enabled</MxButton>
            <MxButton Tone="MxTone.Primary" Disabled="true">Disabled</MxButton>
            <MxButton Tone="MxTone.Danger">Danger</MxButton>
            <MxButton Tone="MxTone.Success">Success</MxButton>
        </div>
    </MxSectionCard>

    <MxSectionCard Title="Tamaños" Class="showcase-section">
        <div class="buttons-row">
            <MxButton Tone="MxTone.Primary" Size="MxSize.Small">Small</MxButton>
            <MxButton Tone="MxTone.Primary" Size="MxSize.Medium">Medium</MxButton>
            <MxButton Tone="MxTone.Primary" Size="MxSize.Large">Large</MxButton>
        </div>
    </MxSectionCard>

    <MxSectionCard Title="Iconografía y combinaciones" Class="showcase-section">
        <div class="buttons-row">
            <MxButton Tone="MxTone.Primary" StartIcon="@Icons.Material.Outlined.Add">Crear</MxButton>
            <MxButton Tone="MxTone.Neutral" EndIcon="@Icons.Material.Outlined.ArrowForward">Continuar</MxButton>
            <MxIconButton Icon="@Icons.Material.Outlined.Settings" AriaLabel="Configuración" Tone="MxTone.Neutral" />
            <MxIconButton Icon="@Icons.Material.Outlined.Search" AriaLabel="Buscar" Tone="MxTone.Primary" />
        </div>
    </MxSectionCard>
</MxPageContainer>
