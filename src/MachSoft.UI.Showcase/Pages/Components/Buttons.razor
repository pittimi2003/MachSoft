@page "/components/buttons"

<MxPageContainer Title="Components / Buttons" Subtitle="Matriz exhaustiva de variantes, estados, tamaños, iconografía y modo enlace.">
  <MudStack Spacing="3">
    <MxSectionCard Title="Variantes y tonos">
      <MudStack Spacing="2">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
          <MxButton Label="Primary" Tone="MxTone.Primary" />
          <MxButton Label="Secondary" Tone="MxTone.Secondary" />
          <MxButton Label="Outline" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" />
          <MxButton Label="Text / Tertiary" Variant="MxVariant.Text" Tone="MxTone.Neutral" />
          <MxButton Label="Success" Tone="MxTone.Success" />
          <MxButton Label="Danger" Tone="MxTone.Danger" />
        </MudStack>
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Estados y comportamiento">
      <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
        <MxButton Label="Normal" />
        <MxButton Label="Disabled" Disabled="true" />
        <MxButton Label="Loading" Loading="true" />
        <MxButton Label="Pressed / Active" Active="true" />
        <MxButton Label="Link mode" Href="https://example.com" Target="_blank" Variant="MxVariant.Text" EndIcon="@Icons.Material.Outlined.OpenInNew" />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Iconografía">
      <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
        <MxButton Label="Icon left" StartIcon="@Icons.Material.Outlined.Add" />
        <MxButton Label="Icon right" EndIcon="@Icons.Material.Outlined.ArrowForward" Variant="MxVariant.Outlined" />
        <MxButton Label="" IconOnly="true" StartIcon="@Icons.Material.Outlined.Settings" />
        <MxButton Label="" IconOnly="true" StartIcon="@Icons.Material.Outlined.Delete" Tone="MxTone.Danger" Variant="MxVariant.Outlined" />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Tamaños">
      <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
        <MxButton Label="Small" Size="MxSize.Small" />
        <MxButton Label="Medium" Size="MxSize.Medium" />
        <MxButton Label="Large" Size="MxSize.Large" />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Caso real (toolbar de expediente)">
      <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MxButton Label="Guardar cambios" StartIcon="@Icons.Material.Outlined.Save" />
        <MxButton Label="Aprobar" Tone="MxTone.Success" StartIcon="@Icons.Material.Outlined.TaskAlt" />
        <MxButton Label="Escalar" Tone="MxTone.Warning" Variant="MxVariant.Outlined" StartIcon="@Icons.Material.Outlined.PriorityHigh" />
        <MxButton Label="Cancelar" Variant="MxVariant.Text" Tone="MxTone.Neutral" />
      </MudStack>
    </MxSectionCard>
  </MudStack>
</MxPageContainer>
