@page "/components/buttons"

<MxPageContainer FullWidth="true" Title="Buttons auditables" Class="showcase-page-stack">
    <MxSectionCard>
        <h2>Propósito</h2>
        <p><code>MxButton</code> acciona comandos de negocio con variantes visuales, tamaños y estado transaccional claro.</p>
    </MxSectionCard>

    <MxSectionCard>
        <h3>Variantes</h3>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MxButton Label="Filled" Variant="MxVariant.Filled" />
            <MxButton Label="Outlined" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" />
            <MxButton Label="Text" Variant="MxVariant.Text" Tone="MxTone.Secondary" />
        </MudStack>
    </MxSectionCard>

    <MxSectionCard>
        <h3>Tamaños</h3>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MxButton Label="Small" Size="MxSize.Small" />
            <MxButton Label="Medium" Size="MxSize.Medium" />
            <MxButton Label="Large" Size="MxSize.Large" />
        </MudStack>
    </MxSectionCard>

    <MxSectionCard>
        <h3>Estados e iconografía</h3>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MxButton Label="Activo" Active="true" />
            <MxButton Label="Loading" Loading="true" />
            <MxButton Label="Disabled" Disabled="true" />
            <MxButton Label="Guardar" StartIcon="@Icons.Material.Outlined.Save" />
            <MxButton Label="Eliminar" Tone="MxTone.Danger" StartIcon="@Icons.Material.Outlined.Delete" />
        </MudStack>
    </MxSectionCard>
</MxPageContainer>
