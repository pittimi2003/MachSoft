@page "/components/checkbox"

<MxPageContainer FullWidth="true" Title="Checkbox" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxCheckbox</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MudStack Spacing="1">
<MxCheckbox Label="Acepto términos" Value="@_check" ValueChanged="v => _check = v" />
<MxCheckbox Label="Deshabilitado" Value="true" Disabled="true" />
</MudStack>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private bool _check;
}
