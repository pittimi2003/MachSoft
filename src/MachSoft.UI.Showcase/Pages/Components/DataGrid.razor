@page "/components/datagrid"

<MxPageContainer FullWidth="true" Title="DataGrid" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxDataGrid</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxDataGrid TItem="DemoRow" Items="@_rows" Columns="@_columns" Title="Clientes" Subtitle="Grid auditable" SearchEnabled="true" QuickFilters="@_filters" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private readonly IReadOnlyList<string> _filters = ["Todos", "Activos", "Inactivos"];
    private readonly IReadOnlyList<DemoRow> _rows = [new("Empresa 1", "Activo"), new("Empresa 2", "Inactivo")];
    private readonly IReadOnlyList<MxDataGridColumn<DemoRow>> _columns = [new("name", "Nombre", x => x.Name), new("status", "Estado", x => x.Status)];
    private sealed record DemoRow(string Name, string Status);
}
