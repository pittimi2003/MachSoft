@page "/components/data-listing"

<ShowcasePageLayout Title="Data Listing / MxDataGrid" Subtitle="Grid empresarial auditado: toolbar, búsqueda, filtros rápidos/avanzados, ordenamiento, selección, estados y composición CRUD en card y dialog.">
  <MudStack Spacing="3">
    <MxSectionCard Title="Escenario operativo real (listing CRUD en card)">
      <MudStack Spacing="2">
        <MxDataGrid TItem="CustomerRow"
                    Title="Backoffice de clientes"
                    Subtitle="Cartera enterprise multi-región con cumplimiento SLA"
                    Items="@FilteredItems"
                    Columns="_columns"
                    SelectedItems="_selected"
                    SelectedItemsChanged="OnSelectedChanged"
                    UsePagination="true"
                    TotalItems="@FilteredItems.Count"
                    CurrentPage="@CurrentPage"
                    CurrentPageChanged="OnPageChanged"
                    PageSize="@PageSize"
                    Loading="@_loading"
                    Error="@_error"
                    SearchEnabled="true"
                    SearchPlaceholder="Buscar por columnas visibles"
                    QuickFilters="_quickFilters"
                    QuickFilterPredicate="OnQuickFilter"
                    EmptyTitle="Sin coincidencias"
                    EmptyDescription="Ajusta filtros o crea un nuevo cliente.">
          <AdvancedFilters>
            <div class="mx-datagrid-advanced-grid">
              <MxSelect Label="Región" Value="@_region" ValueChanged="OnRegionChanged" Options="_regions" />
              <MxSelect Label="SLA" Value="@_sla" ValueChanged="OnSlaChanged" Options="_slaOptions" />
              <MxDateRangePicker Label="Última actividad" Value="@_activityRange" ValueChanged="v => _activityRange = v" />
              <MxCheckbox Label="Solo contratos vencidos" Value="@_onlyExpired" ValueChanged="v => _onlyExpired = v" />
            </div>
          </AdvancedFilters>
          <ToolbarContent>
            <MxButton Label="Nuevo cliente" StartIcon="@Icons.Material.Outlined.Add" />
            <MxButton Label="Exportar" Variant="MxVariant.Outlined" StartIcon="@Icons.Material.Outlined.Download" />
            <MxButton Label="Refrescar" Variant="MxVariant.Text" EndIcon="@Icons.Material.Outlined.Refresh" OnClick="Refresh" />
            <MxButton Label="Abrir en dialog" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" OnClick="_ => _dialogOpen = true" />
          </ToolbarContent>
        </MxDataGrid>
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Estados del DataGrid (auditable)">
      <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
        <MxButton Label="Normal" Variant="@StateVariant(GridState.Normal)" OnClick="_ => _gridState = GridState.Normal" />
        <MxButton Label="Loading" Variant="@StateVariant(GridState.Loading)" OnClick="_ => _gridState = GridState.Loading" />
        <MxButton Label="Error" Variant="@StateVariant(GridState.Error)" OnClick="_ => _gridState = GridState.Error" />
        <MxButton Label="Empty" Variant="@StateVariant(GridState.Empty)" OnClick="_ => _gridState = GridState.Empty" />
        <MxButton Label="Hover preview" Variant="MxVariant.Outlined" Class="mx-force-hover" />
        <MxButton Label="Focus preview" Variant="MxVariant.Outlined" Class="mx-force-focus" />
      </MudStack>
      <MxDataGrid TItem="CustomerRow"
                  Class="mx-grid-state-demo"
                  Title="@($"Estado actual: {_gridState}")"
                  Items="@StateItems"
                  Columns="_columns"
                  Loading="@(_gridState == GridState.Loading)"
                  Error="@(_gridState == GridState.Error)"
                  Selectable="false"
                  SearchEnabled="false"
                  EmptyTitle="Sin resultados para el estado seleccionado" />
    </MxSectionCard>

    <MxSectionCard Title="Posición real en dialog (auditoría de integración)">
      <MudStack Spacing="2">
        <MudText Typo="Typo.body2">Valida uso de MxDataGrid dentro de dialog para selección contextual en flujo CRUD.</MudText>
        <MxDialog Open="@_dialogOpen"
                  Title="Seleccionar clientes para campaña"
                  Message="Elige uno o más clientes desde el grid embebido y confirma la operación."
                  OnConfirm="CloseDialog"
                  OnCancel="CloseDialog">
          <ChildContent>
            <MxDataGrid TItem="CustomerRow"
                        Class="mx-grid-state-demo"
                        Items="@_items.Take(5).ToArray()"
                        Columns="_columns"
                        SelectedItems="_selected"
                        SelectedItemsChanged="OnSelectedChanged"
                        SearchEnabled="true"
                        QuickFilters="_quickFilters"
                        QuickFilterPredicate="OnQuickFilter"
                        UsePagination="true"
                        TotalItems="5"
                        CurrentPage="1"
                        PageSize="3"
                        Title="Selector embebido"
                        Subtitle="Vista condensada para dialog" />
          </ChildContent>
        </MxDialog>
      </MudStack>
    </MxSectionCard>
  </MudStack>
</ShowcasePageLayout>

@code {
  private const int PageSize = 6;
  private bool _loading;
  private bool _error;
  private bool _onlyExpired;
  private bool _dialogOpen;
  private int CurrentPage = 1;
  private string? _region = "Todas";
  private string? _sla = "Todos";
  private GridState _gridState = GridState.Normal;
  private MxDateRange _activityRange = new(DateTime.Today.AddDays(-30), DateTime.Today);
  private IReadOnlyCollection<CustomerRow> _selected = Array.Empty<CustomerRow>();

  private readonly List<string> _quickFilters = ["Activos", "En riesgo", "Vencidos"];
  private readonly List<string> _regions = ["Todas", "MX-Norte", "MX-Centro", "MX-Sur", "US-East", "US-West", "LATAM", "EU", "APAC"];
  private readonly List<string> _slaOptions = ["Todos", "SLA OK", "SLA en riesgo", "SLA vencido"];

  private readonly List<CustomerRow> _items =
  [
    new("Acme Systems", "Activo", "MX-Norte", "SLA OK", DateTime.Today.AddDays(-2), false),
    new("Globex Tech", "Activo", "MX-Centro", "SLA en riesgo", DateTime.Today.AddDays(-8), false),
    new("Initech", "Pendiente", "MX-Sur", "SLA vencido", DateTime.Today.AddDays(-40), true),
    new("Umbrella North", "Inactivo", "US-East", "SLA vencido", DateTime.Today.AddDays(-64), true),
    new("Stark Logistics", "Activo", "US-West", "SLA OK", DateTime.Today.AddDays(-5), false),
    new("Wayne Data", "Pendiente", "LATAM", "SLA en riesgo", DateTime.Today.AddDays(-12), false),
    new("Oscorp", "Activo", "EU", "SLA OK", DateTime.Today.AddDays(-1), false),
    new("Wonka Labs", "Activo", "EU", "SLA OK", DateTime.Today.AddDays(-3), false),
    new("Tyrell Corp", "Inactivo", "APAC", "SLA vencido", DateTime.Today.AddDays(-90), true)
  ];

  private readonly List<MxDataGridColumn<CustomerRow>> _columns =
  [
    new("name", "Cliente", x => x.Name){ IsPrimary = true, Width = "24%" },
    new("status", "Estado", x => x.Status),
    new("region", "Región", x => x.Region),
    new("sla", "Cumplimiento", x => x.Sla),
    new("activity", "Última actividad", x => x.LastActivity.ToString("yyyy-MM-dd"))
  ];

  private IReadOnlyList<CustomerRow> FilteredItems => _items
    .Where(x => _region == "Todas" || x.Region == _region)
    .Where(x => _sla == "Todos" || x.Sla == _sla)
    .Where(x => !_onlyExpired || x.Expired)
    .Where(x => x.LastActivity.Date >= (_activityRange.Start ?? DateTime.MinValue).Date && x.LastActivity.Date <= (_activityRange.End ?? DateTime.MaxValue).Date)
    .ToArray();

  private IReadOnlyList<CustomerRow> StateItems => _gridState == GridState.Empty ? Array.Empty<CustomerRow>() : _items.Take(3).ToArray();

  private Task OnPageChanged(int page) { CurrentPage = page; return Task.CompletedTask; }
  private Task OnSelectedChanged(IReadOnlyCollection<CustomerRow> rows) { _selected = rows; return Task.CompletedTask; }
  private Task OnRegionChanged(string? value) { _region = value; CurrentPage = 1; return Task.CompletedTask; }
  private Task OnSlaChanged(string? value) { _sla = value; CurrentPage = 1; return Task.CompletedTask; }

  private bool OnQuickFilter(CustomerRow row, string filter)
    => filter switch
    {
      "Activos" => row.Status == "Activo",
      "En riesgo" => row.Sla == "SLA en riesgo",
      "Vencidos" => row.Sla == "SLA vencido" || row.Expired,
      _ => true
    };

  private async Task Refresh(MouseEventArgs _)
  {
    _loading = true;
    await Task.Delay(700);
    _loading = false;
  }

  private Task CloseDialog()
  {
    _dialogOpen = false;
    return Task.CompletedTask;
  }

  private MxVariant StateVariant(GridState state) => _gridState == state ? MxVariant.Filled : MxVariant.Outlined;

  private sealed record CustomerRow(string Name, string Status, string Region, string Sla, DateTime LastActivity, bool Expired);
  private enum GridState { Normal, Loading, Error, Empty }
}
