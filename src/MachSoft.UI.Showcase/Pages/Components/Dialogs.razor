@page "/components/dialogs"

<MxPageContainer Title="Components / Dialogs" Subtitle="Diálogos sobrios, de alto contraste y acción primaria cian controlada.">
  <MxSectionCard Title="Confirmación">
    <MxButton Label="Abrir diálogo" OnClick="_ => Open = true" />
    <MxDialog Open="@Open" Title="Eliminar registro" Message="Esta operación es irreversible. ¿Deseas continuar?" OnConfirm="OnClose" OnCancel="OnClose" />
  </MxSectionCard>
</MxPageContainer>

@code {
  private bool Open;
  private Task OnClose() { Open = false; return Task.CompletedTask; }
}
