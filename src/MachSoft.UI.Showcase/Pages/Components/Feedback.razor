@page "/components/feedback"

<MxPageContainer Title="Feedback" Subtitle="Alertas, snackbar/toast, overlay y estados comparables en varios escenarios.">
  <section class="mx-forms-grid">
    <MxSectionCard Title="Alertas y Toast (variantes)">
      <MudStack Spacing="2">
        <MxAlert Tone="MxAlertTone.Info" Message="Hay cambios pendientes de aprobar." />
        <MxAlert Tone="MxAlertTone.Success" Message="Sincronización completa sin incidencias." />
        <MxAlert Tone="MxAlertTone.Warning" Message="La sesión expira en menos de 5 minutos." />
        <MxAlert Tone="MxAlertTone.Error" Message="No fue posible procesar el lote de datos." />
        <MxToast Message="Cliente actualizado correctamente" Tone="MxSnackbarTone.Success" />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Busy Overlay + estados (normal/loading/error/empty)">
      <div style="position:relative; min-height:220px;">
        <MxBusyOverlay Busy="@_busy" />
        <MudStack Spacing="2">
          <MxLoadingState Title="Sincronizando" Description="Procesando lotes de actualización." />
          <MxErrorState Title="Error de conexión" Description="No fue posible guardar los cambios." />
          <MxEmptyState Title="Sin pendientes" Description="No hay incidencias activas para este cliente." />
        </MudStack>
      </div>
      <MxButton Variant="MxVariant.Outlined" OnClick="ToggleBusy">Alternar Busy</MxButton>
    </MxSectionCard>
  </section>
</MxPageContainer>

@code {
  private bool _busy;
  private Task ToggleBusy(MouseEventArgs _) { _busy = !_busy; return Task.CompletedTask; }
}
