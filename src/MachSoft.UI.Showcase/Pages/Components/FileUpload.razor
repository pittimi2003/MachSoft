@page "/components/fileupload"

<MxPageContainer FullWidth="true" Title="FileUpload" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxFileUpload</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxFileUpload Label="Carga de archivos" HelperText="PDF, XLSX o imágenes" />
<MxFileUpload Label="Estado de carga" Uploading="true" UploadProgress="42" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

