@page "/components/forms"

<MxPageContainer Title="Components / Advanced Inputs" Subtitle="Inputs avanzados con API consistente Mx* para captura extensa, selección y toggles de estado.">
  <section class="mx-forms-grid">
    <MxSectionCard Title="MxTextArea">
      <MudStack Spacing="2">
        <MxTextArea Label="Descripción operativa"
                    @bind-Value="Description"
                    Placeholder="Escribe contexto, objetivos y riesgo esperado..."
                    HelperText="Máximo 500 caracteres para resumen ejecutivo." />
        <MxTextArea Label="Observación invalid"
                    Value="@ShortNote"
                    Error="true"
                    ErrorText="Debe tener al menos 20 caracteres."
                    HelperText="Captura un contexto suficiente para auditoría." />
        <MxTextArea Label="Observación disabled"
                    Value="Bloqueada por estado de aprobación."
                    Disabled="true"
                    HelperText="El área se habilita cuando la solicitud vuelve a borrador." />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="MxRadio + MxRadioGroup">
      <MudStack Spacing="2">
        <MudText Typo="Typo.body2">Nivel de criticidad</MudText>
        <MxRadioGroup @bind-Value="RiskLevel">
          <MxRadio Label="Baja" Value="Baja" />
          <MxRadio Label="Media" Value="Media" />
          <MxRadio Label="Alta" Value="Alta" />
          <MxRadio Label="Crítica (disabled)" Value="Crítica" Disabled="true" />
        </MxRadioGroup>
        <MudText Typo="Typo.caption">Selección actual: @RiskLevel</MudText>
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="MxSwitch">
      <MudStack Spacing="2">
        <MxSwitch Label="Publicar cambios en entorno productivo" @bind-Value="PublishToProduction" />
        <MxSwitch Label="Activar notificación por correo" @bind-Value="SendNotifications" Class="mx-demo-force-focus" />
        <MxSwitch Label="Sincronización bloqueada" Value="true" Disabled="true" />
      </MudStack>
    </MxSectionCard>
  </section>
</MxPageContainer>

@code {
  private string? Description;
  private string? RiskLevel = "Media";
  private bool PublishToProduction;
  private bool SendNotifications = true;
  private const string ShortNote = "Corta";
}
