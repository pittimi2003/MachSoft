@page "/components/forms"

<MxPageContainer Title="Components / Forms + Advanced Inputs" Subtitle="Catálogo auditable de controles de formulario: estados, variantes, tamaños y casos operativos en cards, toolbar y dialog.">
  <section class="mx-forms-grid">
    <MxSectionCard Title="Text controls (normal / invalid / disabled / focus)">
      <MudStack Spacing="2">
        <MxTextField Label="Nombre del cliente" Value="@_customerName" ValueChanged="v => _customerName = v" Placeholder="Ingresa razón social" HelperText="Se usará como identificador principal del expediente." />
        <MxTextField Label="Text hover preview" Class="mx-force-hover" Value="Acme Systems" />
        <MxTextField Label="Text focus preview" Class="mx-force-focus" Value="Focus operativo" />
        <MxTextField Label="Nombre invalid" Value="" Error="true" ErrorText="El nombre del cliente es obligatorio." />
        <MxTextArea Label="Observaciones" Value="@_notes" ValueChanged="v => _notes = v" Lines="3" HelperText="Describe hallazgos relevantes del comité." />
        <MxTextArea Label="Observaciones disabled" Value="Bloqueado por estado cerrado" Disabled="true" />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Selection controls (select / checkbox / radio / switch)">
      <MudStack Spacing="2">
        <MxSelect Label="Canal principal" Value="@_mainChannel" ValueChanged="v => _mainChannel = v" Options="_channels" />
        <MxSelect Label="Canal invalid" Value="" Options="_channels" Error="true" ErrorText="Debes elegir un canal primario." />
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
          <MxCheckbox Label="Recibir alertas" Value="@_alerts" ValueChanged="v => _alerts = v" />
          <MxSwitch Label="Activar revisión automática" Value="@_autoReview" ValueChanged="v => _autoReview = v" />
        </MudStack>
        <MudText Typo="Typo.body2">Prioridad</MudText>
        <MxRadioGroup Value="@_priority" ValueChanged="v => _priority = v">
          <MxRadio Value="Alta" Label="Alta" />
          <MxRadio Value="Media" Label="Media" />
          <MxRadio Value="Baja" Label="Baja" />
        </MxRadioGroup>
        <MudText Typo="Typo.caption">Valor seleccionado: @_priority</MudText>
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="MxAutocomplete">
      <MudStack Spacing="2">
        <MxAutocomplete Label="Cliente"
                        @bind-Value="SelectedCustomer"
                        Options="_customers"
                        Placeholder="Busca por nombre o alias..."
                        HelperText="Selecciona un cliente único para operar el expediente." />
        <MxAutocomplete Label="Cliente invalid"
                        Value="@InvalidCustomer"
                        Options="_customers"
                        Error="true"
                        ErrorText="Debes seleccionar un cliente activo del catálogo." />
        <MxAutocomplete Label="Cliente disabled"
                        Value="Acme Systems"
                        Options="_customers"
                        Disabled="true"
                        HelperText="Bloqueado por estado de aprobación." />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="MxMultiSelect (selección múltiple real)">
      <MudStack Spacing="2">
        <MxMultiSelect Label="Canales habilitados"
                       SelectedValues="@SelectedChannels"
                       SelectedValuesChanged="OnChannelsChanged"
                       Options="_channels"
                       Placeholder="Selecciona uno o más canales"
                       HelperText="Los canales seleccionados reciben notificaciones automáticas." />
        <MudText Typo="Typo.caption">Seleccionados: @string.Join(", ", SelectedChannels)</MudText>
        <MxMultiSelect Label="Canales invalid"
                       SelectedValues="_invalidChannels"
                       Options="_channels"
                       Error="true"
                       ErrorText="Debes mantener al menos un canal activo." />
        <MxMultiSelect Label="Canales disabled"
                       SelectedValues="@_disabledChannels"
                       Options="_channels"
                       Disabled="true"
                       HelperText="Configuración bloqueada por política." />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="Escenario real: formulario operativo en Card + Dialog">
      <MudStack Spacing="2">
        <MxCard>
          <MxForm>
            <MxFormSection Title="Alta de ticket">
              <MxTextField Label="Asunto" Value="@_ticketSubject" ValueChanged="v => _ticketSubject = v" />
              <MxMultiSelect Label="Canales de atención" SelectedValues="@SelectedChannels" SelectedValuesChanged="OnChannelsChanged" Options="_channels" />
              <MxDatePicker Label="Fecha compromiso" @bind-Value="ExecutionDate" />
            </MxFormSection>
          </MxForm>
        </MxCard>
        <MudStack Row="true" Spacing="2">
          <MxButton Label="Abrir formulario en dialog" OnClick="_ => _dialogOpen = true" />
          <MxButton Label="Guardar" Loading="@_saving" OnClick="SaveForm" />
        </MudStack>
        <MxDialog Open="@_dialogOpen" Title="Edición rápida" Message="Confirma si deseas persistir los cambios del formulario actual." OnConfirm="ConfirmDialog" OnCancel="CloseDialog" />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="MxDatePicker + MxDateRangePicker">
      <MudStack Spacing="2">
        <MxDatePicker Label="Fecha de ejecución"
                      @bind-Value="ExecutionDate"
                      Placeholder="yyyy-mm-dd"
                      HelperText="Define la fecha de corte operativa." />
        <MxDatePicker Label="Fecha invalid"
                      Value="@InvalidDate"
                      Error="true"
                      ErrorText="La fecha no puede ser anterior al cierre contable." />
        <MxDateRangePicker Label="Ventana de evaluación"
                           Value="@EvaluationRange"
                           ValueChanged="OnRangeChanged"
                           HelperText="Rango analizado para indicadores de cumplimiento." />
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="MxFileUpload (idle, drag, success, error, uploading, disabled)">
      <MudStack Spacing="2">
        <MxFileUpload Label="Evidencia documental"
                      HelperText="Adjunta PDF, Excel o CSV. Límite 15 MB por archivo."
                      Multiple="true"
                      Uploading="@_uploading"
                      UploadProgress="@_uploadProgress"
                      FilesChanged="OnFilesChanged" />
        <MudStack Row="true" Spacing="2">
          <MxButton Label="Simular carga" Variant="MxVariant.Outlined" OnClick="SimulateUpload" />
          <MxButton Label="Reset progreso" Variant="MxVariant.Text" Tone="MxTone.Neutral" OnClick="ResetUpload" />
        </MudStack>
        <MxFileUpload Label="Carga invalid"
                      Error="true"
                      ErrorText="Debes adjuntar un contrato vigente firmado."
                      AllowedExtensions="@_pdfOnly" />
        <MxFileUpload Label="Upload disabled"
                      Disabled="true"
                      Placeholder="Carga bloqueada por estado de aprobación" />
        <MudText Typo="Typo.caption">Archivo(s) seleccionados: @(_selectedFileName ?? "Sin archivo")</MudText>
      </MudStack>
    </MxSectionCard>
  </section>
</MxPageContainer>

@code {
  private string? _customerName;
  private string? _notes;
  private string? _mainChannel = "Portal";
  private bool _alerts = true;
  private bool _autoReview;
  private string _priority = "Media";
  private string? _ticketSubject;
  private bool _dialogOpen;
  private bool _saving;

  private string? SelectedCustomer;
  private const string InvalidCustomer = "Cliente inexistente";
  private readonly List<string> _customers = ["Acme Systems", "Globex Tech", "Initech", "Umbrella North", "Stark Logistics"];

  private IEnumerable<string> SelectedChannels = ["Portal", "Correo"];
  private readonly IEnumerable<string> _disabledChannels = ["Portal", "Webhook"];
  private readonly List<string> _channels = ["Portal", "Correo", "SMS", "Webhook", "Teams"];
  private readonly IEnumerable<string> _invalidChannels = Array.Empty<string>();

  private DateTime? ExecutionDate = DateTime.Today;
  private readonly DateTime? InvalidDate = DateTime.Today.AddDays(-120);
  private MxDateRange EvaluationRange = new(DateTime.Today.AddDays(-14), DateTime.Today.AddDays(14));

  private bool _uploading;
  private int _uploadProgress;
  private string? _selectedFileName;

  private Task OnChannelsChanged(IEnumerable<string> values)
  {
    SelectedChannels = values.ToArray();
    return Task.CompletedTask;
  }

  private Task OnRangeChanged(MxDateRange value)
  {
    EvaluationRange = value;
    return Task.CompletedTask;
  }

  private readonly IReadOnlyList<string> _pdfOnly = [".pdf"];

  private Task OnFilesChanged(IReadOnlyList<IBrowserFile> files)
  {
    _selectedFileName = files.Count == 0 ? null : string.Join(", ", files.Select(x => x.Name));
    return Task.CompletedTask;
  }

  private async Task SaveForm(MouseEventArgs _)
  {
    _saving = true;
    await Task.Delay(400);
    _saving = false;
  }

  private Task ConfirmDialog()
  {
    _dialogOpen = false;
    return Task.CompletedTask;
  }

  private Task CloseDialog()
  {
    _dialogOpen = false;
    return Task.CompletedTask;
  }

  private async Task SimulateUpload(MouseEventArgs _)
  {
    _uploading = true;
    for (var i = 0; i <= 100; i += 20)
    {
      _uploadProgress = i;
      await Task.Delay(120);
      StateHasChanged();
    }

    _uploading = false;
  }

  private Task ResetUpload(MouseEventArgs _)
  {
    _uploading = false;
    _uploadProgress = 0;
    return Task.CompletedTask;
  }
}
