@page "/components/radio"

<MxPageContainer FullWidth="true" Title="Radio" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxRadioGroup</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxRadioGroup Value="@_radio" ValueChanged="v => _radio = v">
  <MxRadio Value="A" Label="Opción A" />
  <MxRadio Value="B" Label="Opción B" />
</MxRadioGroup>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private string? _radio="A";
}
