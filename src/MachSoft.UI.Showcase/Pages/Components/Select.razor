@page "/components/select"

<MxPageContainer FullWidth="true" Title="Select" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxSelect</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxSelect Label="Pais" Options="@_options" Value="@_selected" ValueChanged="v => _selected = v" />
<MxSelect Label="Error" Options="@_options" Error="true" ErrorText="Selecciona una opción" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private readonly IReadOnlyList<string> _options = ["México", "Colombia", "Chile"];
    private string? _selected;
}
