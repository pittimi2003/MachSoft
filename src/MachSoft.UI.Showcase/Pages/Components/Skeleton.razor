@page "/components/skeleton"

<MxPageContainer FullWidth="true" Title="Skeleton" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxSkeleton</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxSkeleton Shape="MxSkeletonShape.Text" Width="100%" />
<MxSkeleton Shape="MxSkeletonShape.Rectangle" Width="100%" Height="120px" />
<MxSkeleton Shape="MxSkeletonShape.Circle" Width="56px" Height="56px" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

