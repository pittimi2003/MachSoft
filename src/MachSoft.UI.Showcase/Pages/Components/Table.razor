@page "/components/table"

<MxPageContainer FullWidth="true" Title="Table" Class="showcase-page-stack">
    <MxSectionCard>
        <h2>Propósito</h2>
        <p><code>MxTable</code> presenta colecciones con estructura de columnas y lectura rápida de estado.</p>
    </MxSectionCard>

    <MxSectionCard>
        <h3>Combinaciones básicas</h3>
        <MxTable TItem="OrderRow" Items="@Rows" Columns="@Columns" />
    </MxSectionCard>
</MxPageContainer>

@code {
    private readonly IReadOnlyList<MxTableColumn<OrderRow>> Columns =
    [
        new("id", "Id", row => row.Id, true),
        new("customer", "Cliente", row => row.Customer),
        new("status", "Estado", row => row.Status),
        new("total", "Total", row => row.Total)
    ];

    private readonly IReadOnlyList<OrderRow> Rows =
    [
        new(1001, "ACME", "Pendiente", "$1240"),
        new(1002, "Globex", "Aprobado", "$890"),
        new(1003, "Initech", "En revisión", "$2210")
    ];

    private sealed record OrderRow(int Id, string Customer, string Status, string Total);
}
