@page "/components/table"

<MxPageContainer FullWidth="true" Title="Table" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxTable</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxTable TItem="DemoRow" Items="@_rows" Columns="@_columns" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private readonly IReadOnlyList<DemoRow> _rows = [new("A-01", "Activo"), new("A-02", "Pendiente")];
    private readonly IReadOnlyList<MxTableColumn<DemoRow>> _columns = [new("code", "Código", x => x.Code, true), new("status", "Estado", x => x.Status)];
    private sealed record DemoRow(string Code, string Status);
}
