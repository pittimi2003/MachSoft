@page "/components/tabs"

<MxPageContainer FullWidth="true" Title="Tabs" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxTabs</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxTabs Items="@_tabs" ActiveIndex="@_tab" ActiveIndexChanged="v => _tab = v" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private int _tab;
    private readonly IReadOnlyList<MxTabItem> _tabs =
    [
        new("overview", "Overview", builder => builder.AddContent(0, "Resumen del componente")),
        new("api", "API", builder => builder.AddContent(0, "Parámetros principales")),
        new("usage", "Uso", builder => builder.AddContent(0, "Combinaciones recomendadas"))
    ];
}
