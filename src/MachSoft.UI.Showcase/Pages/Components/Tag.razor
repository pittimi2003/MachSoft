@page "/components/tag"

<MxPageContainer FullWidth="true" Title="Tag" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxTag</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
<MxTag Text="Nuevo" Tone="MxTone.Primary" />
<MxTag Text="QA" Tone="MxTone.Success" />
<MxTag Text="Legacy" Tone="MxTone.Warning" />
</MudStack>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

