@page "/components/textarea"

<MxPageContainer FullWidth="true" Title="TextArea" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxTextArea</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxTextArea Label="Descripción" Value="@_desc" ValueChanged="v => _desc = v" HelperText="Máximo 500 caracteres" />
<MxTextArea Label="Error" Error="true" ErrorText="Campo requerido" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private string? _desc;
}
