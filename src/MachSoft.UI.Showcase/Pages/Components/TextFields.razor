@page "/components/textfields"

<MxPageContainer FullWidth="true" Title="TextFields" Class="showcase-page-stack">
    <MxSectionCard>
        <h2>Propósito</h2>
        <p><code>MxTextField</code> captura texto con soporte de tamaño, tono, validación y estados deshabilitados.</p>
    </MxSectionCard>

    <div class="showcase-grid-two">
        <MxSectionCard>
            <h3>Variantes y tamaños</h3>
            <MudStack Spacing="2">
                <MxTextField Label="Default" Placeholder="Escribe un valor" />
                <MxTextField Label="Small" Size="MxSize.Small" Placeholder="Small" />
                <MxTextField Label="Large" Size="MxSize.Large" Placeholder="Large" />
            </MudStack>
        </MxSectionCard>

        <MxSectionCard>
            <h3>Estados</h3>
            <MudStack Spacing="2">
                <MxTextField Label="Con error" Error="true" HelperText="Dato obligatorio" />
                <MxTextField Label="Disabled" Disabled="true" Value="No editable" />
                <MxTextField Label="ReadOnly" ReadOnly="true" Value="Solo lectura" />
            </MudStack>
        </MxSectionCard>
    </div>
</MxPageContainer>
