@page "/components/textfields"

<MxPageContainer FullWidth="true" Title="TextFields" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxTextField</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxTextField Label="Nombre" Value="@_name" ValueChanged="v => _name = v" Placeholder="Ingresa nombre" HelperText="Campo obligatorio" />
<MxTextField Label="Con ícono" Value="@_search" ValueChanged="v => _search = v" StartIcon="@Icons.Material.Outlined.Search" />
<MxTextField Label="Estado error" Error="true" ErrorText="Formato inválido" Value="dato" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private string? _name;
    private string? _search;
}
