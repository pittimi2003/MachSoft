@page "/components/timepicker"

<MxPageContainer FullWidth="true" Title="TimePicker" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxTimePicker</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MxTimePicker Label="Hora" Value="@_time" ValueChanged="v => _time = v" />
<MxTimePicker Label="Hora deshabilitada" Disabled="true" Value="@TimeSpan.FromHours(8)" />
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

@code {
    private TimeSpan? _time = TimeSpan.FromHours(9);
}
