@page "/components/tooltip"

<MxPageContainer FullWidth="true" Title="Tooltip" Class="showcase-page">
    <div class="showcase-page-stack">
        <MxSectionCard>
            <MudText Typo="Typo.h5">MxTooltip</MudText>
            <MudText Typo="Typo.body2">Componente público Mx* con ejemplos auditables de propósito, variantes y estados.</MudText>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Variantes y combinaciones</MudText>
            <MudStack Row="true" Spacing="2">
<MxTooltip Text="Acción principal"><MxButton Label="Guardar" /></MxTooltip>
<MxTooltip Text="Eliminar registro"><MxIconButton Icon="@Icons.Material.Outlined.Delete" Tone="MxTone.Danger" /></MxTooltip>
</MudStack>
        </MxSectionCard>

        <MxSectionCard>
            <MudText Typo="Typo.h6">Estados de uso</MudText>
            <MudText Typo="Typo.body2">Se valida comportamiento en estado por defecto, alterno y contextual dentro de layouts reales.</MudText>
        </MxSectionCard>
    </div>
</MxPageContainer>

