@page "/foundations/colors"

<MxPageContainer FullWidth="true" Class="showcase-page">
    <section class="showcase-hero">
        <p class="showcase-kicker">Foundations</p>
        <h1>Color system de MachSoft</h1>
        <p>Tokens de marca, neutrales y semánticos auditables en composición central dominante.</p>
    </section>

    <MxSectionCard Title="Brand tokens" Class="showcase-section">
        <div class="token-grid">
            @foreach (var token in BrandTokens)
            {
                <article class="token-card">
                    <div class="token-chip" style="@($"background:{token.Hex}")"></div>
                    <strong>@token.Name</strong>
                    <span>@token.Hex</span>
                </article>
            }
        </div>
    </MxSectionCard>

    <MxSectionCard Title="Neutrales" Class="showcase-section">
        <div class="token-grid">
            @foreach (var token in NeutralTokens)
            {
                <article class="token-card">
                    <div class="token-chip" style="@($"background:{token.Hex}")"></div>
                    <strong>@token.Name</strong>
                    <span>@token.Hex</span>
                </article>
            }
        </div>
    </MxSectionCard>

    <MxSectionCard Title="Semánticos" Class="showcase-section">
        <div class="token-grid">
            @foreach (var token in SemanticTokens)
            {
                <article class="token-card">
                    <div class="token-chip" style="@($"background:{token.Hex}")"></div>
                    <strong>@token.Name</strong>
                    <span>@token.Hex</span>
                </article>
            }
        </div>
    </MxSectionCard>

    <MxSectionCard Title="Criterios de uso" Class="showcase-section">
        <ul>
            <li>Brand para identidad y llamadas primarias.</li>
            <li>Neutrales para superficies, bordes y lectura.</li>
            <li>Semánticos solo para feedback contextual.</li>
        </ul>
    </MxSectionCard>
</MxPageContainer>

@code {
    private static readonly (string Name, string Hex)[] BrandTokens =
    [
        ("Brand / 700", "#0044C9"),
        ("Brand / 500", "#0E63F4"),
        ("Brand / 300", "#7EB0FF")
    ];

    private static readonly (string Name, string Hex)[] NeutralTokens =
    [
        ("Neutral / 950", "#101828"),
        ("Neutral / 700", "#344054"),
        ("Neutral / 300", "#D0D5DD"),
        ("Neutral / 50", "#F9FAFB")
    ];

    private static readonly (string Name, string Hex)[] SemanticTokens =
    [
        ("Success", "#12B76A"),
        ("Warning", "#F79009"),
        ("Danger", "#F04438"),
        ("Info", "#2E90FA")
    ];
}
