@page "/foundations/colors"

<MxPageContainer FullWidth="true" Title="Color system de MachSoft" Class="showcase-page-stack">
    <MxSectionCard>
        <h2>System intent</h2>
        <p>La paleta define capas para acciones primarias, estados semánticos y legibilidad en superficies claras u oscuras.</p>
    </MxSectionCard>

    <div class="showcase-token-grid">
        @foreach (var token in BrandTokens)
        {
            <div class="showcase-token">
                <div class="showcase-token-swatch" style="background:@token.Hex"></div>
                <div class="showcase-token-meta"><strong>@token.Name</strong><br />@token.Hex</div>
            </div>
        }
    </div>

    <MxSectionCard>
        <h2>Neutros y semánticos</h2>
        <p>Combina neutros para estructura (fondo, borde, texto) y semánticos para feedback (éxito, advertencia, error, información).</p>
        <p>Evita usar semánticos como color base de branding para preservar consistencia de intención.</p>
    </MxSectionCard>
</MxPageContainer>

@code {
    private static readonly IReadOnlyList<(string Name, string Hex)> BrandTokens =
    [
        ("Brand / Primary", "#1F4B99"),
        ("Brand / Secondary", "#12807A"),
        ("Neutral / Surface", "#F7F9FC"),
        ("Neutral / Ink", "#1F2937"),
        ("Semantic / Success", "#16A34A"),
        ("Semantic / Warning", "#D97706"),
        ("Semantic / Danger", "#DC2626"),
        ("Semantic / Info", "#2563EB")
    ];
}
