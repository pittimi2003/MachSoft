@page "/foundations/radius-elevation"

<MxPageContainer Title="Foundations / Radius & Elevation" Subtitle="Lenguaje geométrico con radios contenidos y elevación sobria.">
  <MxSectionCard Title="Radius policy">
    <MudStack Row="true" Spacing="2">
      <MudPaper Elevation="0" Class="mx-foundation-sample d-flex align-center justify-center" Style="width:100px;height:60px;border-radius:4px;">4px</MudPaper>
      <MudPaper Elevation="0" Class="mx-foundation-sample d-flex align-center justify-center" Style="width:100px;height:60px;border-radius:8px;">8px</MudPaper>
      <MudPaper Elevation="0" Class="mx-foundation-sample d-flex align-center justify-center" Style="width:100px;height:60px;border-radius:12px;">12px</MudPaper>
    </MudStack>
  </MxSectionCard>

  <MxSectionCard Title="Elevation policy">
    <MudStack Spacing="2">
      <MudPaper Elevation="0" Class="pa-3 mx-foundation-sample">Flat + Border</MudPaper>
      <MudPaper Elevation="1" Class="pa-3 mx-foundation-sample">Elevation 1 (operativo)</MudPaper>
      <MudPaper Elevation="2" Class="pa-3 mx-foundation-sample">Elevation 2 (destacado)</MudPaper>
    </MudStack>
  </MxSectionCard>
</MxPageContainer>
