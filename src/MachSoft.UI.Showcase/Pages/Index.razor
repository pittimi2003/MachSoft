@page "/"

<MxPageContainer Title="MachSoft UI Platform" Subtitle="Sistema visual oficial enterprise técnico de MachSoft basado en grafito estructural y acento cian controlado.">
  <MxSectionCard Title="Dirección oficial activa">
    <MudText Typo="Typo.body2">Base estructural: <strong>familia Graphite</strong>. Accent oficial: <strong>#00B5D8</strong>. Azul profundo secundario: <strong>#123E73</strong> para soporte institucional.</MudText>
