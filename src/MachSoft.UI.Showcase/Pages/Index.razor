@page "/"

<MxPageContainer FullWidth="true" Class="showcase-page">
    <section class="showcase-hero">
        <p class="showcase-kicker">MachSoft UI Platform</p>
        <h1>Superficie principal dominante para auditar el catálogo Mx*</h1>
        <p>
            Este host demuestra el contrato de plataforma con un MainContent amplio y estable.
            NavigationMenu, LeftSidebar y RightSidebar se mantienen como regiones secundarias.
        </p>
    </section>

    <section class="showcase-home-grid">
        <MxSectionCard Title="Resumen de plataforma" Class="showcase-main-panel">
            <div class="showcase-metrics">
                <article>
                    <span>Shell global</span>
                    <strong>MxWorkspaceLayout</strong>
                </article>
                <article>
                    <span>Contrato público</span>
                    <strong>Componentes Mx*</strong>
                </article>
                <article>
                    <span>Estado inicial</span>
                    <strong>Overlay cerrado</strong>
                </article>
            </div>

            <div class="showcase-surface-grid">
                <MxSectionCard Title="Bloque principal">
                    <p>Composición central para demostrar lectura, densidad y jerarquía en ancho completo.</p>
                </MxSectionCard>
                <MxSectionCard Title="Panel operativo">
                    <p>Espacio para escenarios de catálogo, muestras y guías de consumo.</p>
                </MxSectionCard>
            </div>
        </MxSectionCard>

        <aside class="showcase-rail">
            <MxSectionCard Title="Rail contextual">
                <ul>
                    <li>Checklist de revisión visual.</li>
                    <li>Accesibilidad y contraste.</li>
                    <li>Consistencia de tokens.</li>
                </ul>
            </MxSectionCard>
        </aside>
    </section>
</MxPageContainer>
