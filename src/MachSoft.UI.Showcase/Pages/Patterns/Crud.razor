@page "/patterns/crud"

<MxPageContainer Title="Patterns / CRUD" Subtitle="Patrón operativo completo: header + toolbar + filtros + datagrid + confirmación + estados.">
  <MxSectionCard Title="MxEntityHeader + MxCrudToolbar">
    <MudStack Spacing="2">
      <MxEntityHeader Title="Clientes" Subtitle="Gestión de entidades del módulo comercial">
        <Meta>
          <MxTag Text="SLA 99.9%" Tone="MxTone.Success" />
        </Meta>
      </MxEntityHeader>

      <MxCrudToolbar Title="Backoffice de clientes" Subtitle="Operaciones de alta, edición y desactivación.">
        <MxButton Tone="MxTone.Primary">Nuevo</MxButton>
        <MxButton Variant="MxVariant.Outlined">Editar</MxButton>
        <MxButton Variant="MxVariant.Outlined">Desactivar</MxButton>
      </MxCrudToolbar>

      <MxFilterBar>
        <MxSearchBox Value="@_search" ValueChanged="v => _search = v" />
      </MxFilterBar>

      <MxDataGrid TItem="CustomerRow"
                  Items="Filtered"
                  Columns="_columns"
                  SelectedItems="_selectedRows"
                  SelectedItemsChanged="OnSelectedChanged"
                  EmptyTitle="No hay clientes"
                  EmptyDescription="Ajusta filtros o crea un nuevo registro." />

      <MxConfirmDialog Open="@_confirmOpen"
                       Title="Confirmar desactivación"
                       Message="¿Seguro que deseas desactivar los clientes seleccionados?"
                       ConfirmText="Desactivar"
                       CancelText="Cancelar"
                       OnClose="OnDialogClose"
                       OnConfirm="OnDialogConfirm" />
    </MudStack>
  </MxSectionCard>
</MxPageContainer>

@code {
  private bool _confirmOpen;
  private string? _search;
  private IReadOnlyCollection<CustomerRow> _selectedRows = Array.Empty<CustomerRow>();

  private readonly List<CustomerRow> _items =
  [
    new("Acme Systems", "Activo", "MX-Norte"), new("Globex Tech", "Activo", "MX-Centro"), new("Initech", "Pendiente", "MX-Sur")
  ];

  private readonly List<MxDataGridColumn<CustomerRow>> _columns =
  [
    new("name", "Cliente", x => x.Name){ IsPrimary = true },
    new("status", "Estado", x => x.Status),
    new("region", "Región", x => x.Region)
  ];

  private IReadOnlyList<CustomerRow> Filtered => _items
      .Where(x => string.IsNullOrWhiteSpace(_search) || x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
      .ToArray();

  private Task OnSelectedChanged(IReadOnlyCollection<CustomerRow> rows)
  {
    _selectedRows = rows;
    _confirmOpen = rows.Count > 0;
    return Task.CompletedTask;
  }

  private Task OnDialogClose() { _confirmOpen = false; return Task.CompletedTask; }
  private Task OnDialogConfirm() { _confirmOpen = false; return Task.CompletedTask; }

  private sealed record CustomerRow(string Name, string Status, string Region);
}
