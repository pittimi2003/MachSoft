@page "/states/feedback"

<MxPageContainer Title="States / Feedback & Confirmation" Subtitle="Bloque 2: notificaciones y confirmaciones operativas sin exponer Mud* en la capa consumidora.">
  <section class="mx-feedback-grid">
    <MxSectionCard Title="MxSnackbar">
      <MudStack Spacing="2">
        <MudText Typo="Typo.body2">Dispara feedback contextual con tonos operativos.</MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
          <MxButton Label="Info" Variant="MxVariant.Outlined" Tone="MxTone.Neutral" OnClick="_ => ShowSnackbar(MxSnackbarTone.Info)" />
          <MxButton Label="Success" Variant="MxVariant.Outlined" Tone="MxTone.Success" OnClick="_ => ShowSnackbar(MxSnackbarTone.Success)" />
          <MxButton Label="Warning" Variant="MxVariant.Outlined" Tone="MxTone.Warning" OnClick="_ => ShowSnackbar(MxSnackbarTone.Warning)" />
          <MxButton Label="Error" Variant="MxVariant.Outlined" Tone="MxTone.Danger" OnClick="_ => ShowSnackbar(MxSnackbarTone.Error)" />
        </MudStack>
      </MudStack>
    </MxSectionCard>

    <MxSectionCard Title="MxConfirmDialog">
      <MudStack Spacing="2">
        <MudText Typo="Typo.body2">Confirma acciones críticas manteniendo jerarquía visual.</MudText>
        <MxButton Label="Abrir confirmación" Tone="MxTone.Primary" OnClick="OpenDialog" />
      </MudStack>

      <MxConfirmDialog Open="@ConfirmOpen"
                       Title="Eliminar cliente"
                       Message="Esta acción deshabilita el cliente en todos los flujos activos. ¿Deseas continuar?"
                       ConfirmText="Sí, eliminar"
                       CancelText="No, cancelar"
                       OnConfirm="ConfirmDelete"
                       OnCancel="CancelDelete" />
    </MxSectionCard>
  </section>

  <MxSnackbar @ref="Snackbar" />
</MxPageContainer>

@code {
  private MxSnackbar? Snackbar;
  private bool ConfirmOpen;

  private Task OpenDialog(MouseEventArgs _)
  {
    ConfirmOpen = true;
    return Task.CompletedTask;
  }

  private Task ShowSnackbar(MxSnackbarTone tone)
  {
    Snackbar?.Show(tone switch
    {
      MxSnackbarTone.Success => "Operación completada correctamente.",
      MxSnackbarTone.Warning => "Hay elementos pendientes de validación.",
      MxSnackbarTone.Error => "No fue posible completar la solicitud.",
      _ => "Información actualizada para el usuario operativo."
    }, tone);

    return Task.CompletedTask;
  }

  private Task ConfirmDelete()
  {
    ConfirmOpen = false;
    Snackbar?.Show("El cliente fue marcado para baja.", MxSnackbarTone.Success);
    return Task.CompletedTask;
  }

  private Task CancelDelete()
  {
    ConfirmOpen = false;
    Snackbar?.Show("Acción cancelada por el usuario.", MxSnackbarTone.Info);
    return Task.CompletedTask;
  }
}
