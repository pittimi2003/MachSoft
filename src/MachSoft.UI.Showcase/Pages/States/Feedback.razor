@page "/states/feedback"

<MxPageContainer Title="States" Subtitle="Estados operativos consistentes con contraste frío y jerarquía enterprise.">
  <MxSectionCard Title="Empty">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No hay datos para el filtro aplicado.</MudAlert>
  </MxSectionCard>

  <MxSectionCard Title="Loading">
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
      <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
      <MudText Typo="Typo.body2">Sincronizando registros...</MudText>
    </MudStack>
  </MxSectionCard>

  <MxSectionCard Title="Error">
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">Error de conexión con el servicio de clientes.</MudAlert>
  </MxSectionCard>
</MxPageContainer>
