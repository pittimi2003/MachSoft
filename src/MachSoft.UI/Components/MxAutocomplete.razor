<MudAutocomplete T="string"
                 Class="@BuildClass()"
                 Label="@Label"
                 Value="@Value"
                 ValueChanged="@ValueChanged"
                 SearchFunc="SearchAsync"
                 CoerceText="true"
                 CoerceValue="true"
                 Placeholder="@Placeholder"
                 HelperText="@HelperText"
                 Error="@Error"
                 ErrorText="@ErrorText"
                 Disabled="@Disabled"
                 Immediate="true"
                 Margin="Margin.Dense"
                 Variant="MudBlazor.Variant.Outlined"
                 FullWidth="true"
                 Clearable="true" />

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string HelperText { get; set; } = string.Empty;
    [Parameter] public string ErrorText { get; set; } = string.Empty;
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string BuildClass() => string.IsNullOrWhiteSpace(Class) ? "mx-autocomplete" : $"mx-autocomplete {Class}";

    private Task<IEnumerable<string>> SearchAsync(string? value, CancellationToken token)
    {
        var query = value?.Trim();
        IEnumerable<string> result = string.IsNullOrWhiteSpace(query)
            ? Options
            : Options.Where(o => o.Contains(query, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result);
    }
}
