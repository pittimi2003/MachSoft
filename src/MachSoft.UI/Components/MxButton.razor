<MudButton Class="@BuildClass()"
           Variant="@MapVariant()"
           Color="@MapColor()"
           Size="@MapSize()"
           Disabled="@ComputedDisabled"
           Href="@Href"
           Target="@Target"
           StartIcon="@StartIcon"
           EndIcon="@EndIcon"
           OnClick="HandleClick">
    @if (Loading)
    {
        <MudProgressCircular Class="mx-btn-spinner" Color="Color.Inherit" Size="MudBlazor.Size.Small" Indeterminate="true" />
    }

    @if (!IconOnly)
    {
        if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Label
        }
    }
</MudButton>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public MxTone Tone { get; set; } = MxTone.Primary;
    [Parameter] public MxVariant Variant { get; set; } = MxVariant.Filled;
    [Parameter] public MxSize Size { get; set; } = MxSize.Medium;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? EndIcon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private bool ComputedDisabled => Disabled || Loading;

    private string BuildClass()
    {
        var classes = new List<string> { "mx-btn" };
        if (Active) classes.Add("mx-btn-active");
        if (Loading) classes.Add("mx-btn-loading");
        if (IconOnly) classes.Add("mx-btn-icon-only");
        if (!string.IsNullOrWhiteSpace(Class)) classes.Add(Class);
        return string.Join(' ', classes);
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (ComputedDisabled)
        {
            return;
        }

        await OnClick.InvokeAsync(args);
    }

    private Color MapColor() => Tone switch
    {
        MxTone.Secondary => Color.Secondary,
        MxTone.Success => Color.Success,
        MxTone.Warning => Color.Warning,
        MxTone.Danger => Color.Error,
        MxTone.Neutral => Color.Default,
        _ => Color.Primary
    };

    private Variant MapVariant() => Variant switch
    {
        MxVariant.Outlined => MudBlazor.Variant.Outlined,
        MxVariant.Text => MudBlazor.Variant.Text,
        _ => MudBlazor.Variant.Filled
    };

    private Size MapSize() => Size switch
    {
        MxSize.Small => MudBlazor.Size.Small,
        MxSize.Large => MudBlazor.Size.Large,
        _ => MudBlazor.Size.Medium
    };
}
