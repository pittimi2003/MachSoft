@typeparam TItem

<div class="@BuildClass()">
    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Subtitle) || SearchEnabled || QuickFilters.Count > 0 || AdvancedFilters is not null || ToolbarContent is not null || Selectable)
    {
        <div class="mx-datagrid-toolbar">
            <div>
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h4>@Title</h4>
                }
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p>@Subtitle</p>
                }
            </div>
            <div class="mx-datagrid-toolbar-actions">
                @if (SearchEnabled)
                {
                    <MxSearchBox Label="Buscar" Value="@_search" ValueChanged="OnSearchChanged" Placeholder="@SearchPlaceholder" />
                }
                @if (QuickFilters.Count > 0)
                {
                    <div class="mx-datagrid-quick-filters">
                        @foreach (var filter in QuickFilters)
                        {
                            var active = string.Equals(_activeQuickFilter, filter, StringComparison.OrdinalIgnoreCase);
                            <MxButton Label="@filter"
                                      Variant="@(active ? MxVariant.Filled : MxVariant.Outlined)"
                                      Size="MxSize.Small"
                                      Tone="@(active ? MxTone.Primary : MxTone.Neutral)"
                                      OnClick="_ => OnQuickFilterChange(filter)" />
                        }
                    </div>
                }
                @if (AdvancedFilters is not null)
                {
                    <MxButton Label="@(_advancedOpen ? "Ocultar filtros" : "Filtros avanzados")"
                              Variant="MxVariant.Text"
                              Tone="MxTone.Neutral"
                              EndIcon="@(_advancedOpen ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)"
                              OnClick="_ => ToggleAdvanced()" />
                }
                @if (Selectable)
                {
                    <span class="mx-datagrid-selection-meta">@_selectedSet.Count seleccionados</span>
                }
                @ToolbarContent
            </div>
        </div>
    }

    @if (_advancedOpen && AdvancedFilters is not null)
    {
        <div class="mx-datagrid-advanced-filters">@AdvancedFilters</div>
    }

    @if (Error)
    {
        <MxErrorState Title="@ErrorTitle" Description="@ErrorDescription" Compact="true" />
    }
    else if (Loading)
    {
        <MxLoadingState Title="@LoadingTitle" Description="@LoadingDescription" Compact="true" />
    }
    else if (FilteredItems.Count == 0)
    {
        <MxEmptyState Title="@EmptyTitle" Description="@EmptyDescription" Compact="true" />
    }
    else
    {
        <MudDataGrid T="TItem"
                     Items="@PagedItems"
                     Dense="true"
                     Hover="true"
                     Bordered="false"
                     ReadOnly="true"
                     Striped="false"
                     MultiSelection="@Selectable"
                     SelectOnRowClick="@SelectOnRowClick"
                     SortMode="SortMode.Multiple"
                     SelectedItems="@_selectedSet"
                     SelectedItemsChanged="OnMudSelectedChanged"
                     Class="mx-datagrid-table"
                     Loading="@Loading"
                     RowClassFunc="BuildRowClass">
            <Columns>
                @if (Selectable)
                {
                    <SelectColumn T="TItem" />
                }
                @foreach (var column in Columns)
                {
                    <TemplateColumn T="TItem"
                                    Title="@column.Header"
                                    SortBy="@(item => column.ValueSelector(item))"
                                    Sortable="@Sortable"
                                    HeaderStyle="@BuildHeaderStyle(column)">
                        <CellTemplate>
                            <span class="@(column.IsPrimary ? "mx-datagrid-primary" : string.Empty)">
                                @if (column.CellTemplate is not null)
                                {
                                    @column.CellTemplate(context.Item)
                                }
                                else
                                {
                                    @column.ValueSelector(context.Item)
                                }
                            </span>
                        </CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
        </MudDataGrid>
    }

    @if (UsePagination)
    {
        <MxPaginator CurrentPage="@NormalizedPage" CurrentPageChanged="CurrentPageChanged" TotalItems="@ResolvedTotalItems" PageSize="@PageSize" />
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<MxDataGridColumn<TItem>> Columns { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public string ErrorTitle { get; set; } = "No se pudo cargar el listado";
    [Parameter] public string ErrorDescription { get; set; } = "Verifica conectividad e intenta nuevamente.";
    [Parameter] public string LoadingTitle { get; set; } = "Cargando registros";
    [Parameter] public string LoadingDescription { get; set; } = "Consultando datos...";
    [Parameter] public bool SearchEnabled { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "Buscar por cualquier columna";
    [Parameter] public bool Sortable { get; set; } = true;
    [Parameter] public IReadOnlyList<string> QuickFilters { get; set; } = [];
    [Parameter] public Func<TItem, string, bool>? QuickFilterPredicate { get; set; }
    [Parameter] public RenderFragment? AdvancedFilters { get; set; }
    [Parameter] public bool Selectable { get; set; } = true;
    [Parameter] public bool SelectOnRowClick { get; set; } = true;
    [Parameter] public IReadOnlyCollection<TItem> SelectedItems { get; set; } = Array.Empty<TItem>();
    [Parameter] public EventCallback<IReadOnlyCollection<TItem>> SelectedItemsChanged { get; set; }
    [Parameter] public bool UsePagination { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public int? TotalItems { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public string EmptyTitle { get; set; } = "Sin datos";
    [Parameter] public string EmptyDescription { get; set; } = "No se encontraron registros para los filtros activos.";
    [Parameter] public RenderFragment? ToolbarContent { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private bool _advancedOpen;
    private string? _search;
    private string? _activeQuickFilter;
    private HashSet<TItem> _selectedSet = [];

    protected override void OnParametersSet()
    {
        var incoming = SelectedItems.ToHashSet();
        if (!_selectedSet.SetEquals(incoming))
        {
            _selectedSet = incoming;
        }
    }

    private int ResolvedTotalItems => TotalItems ?? FilteredItems.Count;
    private int NormalizedPage => Math.Max(CurrentPage, 1);

    private IReadOnlyList<TItem> FilteredItems
    {
        get
        {
            IEnumerable<TItem> query = Items;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(MatchSearch);
            }

            if (!string.IsNullOrWhiteSpace(_activeQuickFilter) && QuickFilterPredicate is not null)
            {
                query = query.Where(item => QuickFilterPredicate(item, _activeQuickFilter));
            }

            return query.ToArray();
        }
    }

    private IReadOnlyList<TItem> PagedItems
    {
        get
        {
            if (!UsePagination)
            {
                return FilteredItems;
            }

            var pageSize = Math.Max(PageSize, 1);
            return FilteredItems
                .Skip((NormalizedPage - 1) * pageSize)
                .Take(pageSize)
                .ToArray();
        }
    }

    private bool MatchSearch(TItem item)
        => Columns.Any(c => c.ValueSelector(item)?.ToString()?.Contains(_search!, StringComparison.OrdinalIgnoreCase) == true);

    private string BuildClass() => string.IsNullOrWhiteSpace(Class) ? "mx-datagrid" : $"mx-datagrid {Class}";

    private string BuildHeaderStyle(MxDataGridColumn<TItem> column)
        => $"text-align:{column.Align};width:{column.Width ?? "auto"};";

    private string BuildRowClass(TItem item, int _)
        => _selectedSet.Contains(item) ? "mx-datagrid-row-selected" : string.Empty;

    private Task ToggleAdvanced()
    {
        _advancedOpen = !_advancedOpen;
        return Task.CompletedTask;
    }

    private Task OnMudSelectedChanged(HashSet<TItem> selected)
    {
        _selectedSet = selected;
        return SelectedItemsChanged.InvokeAsync(_selectedSet.ToArray());
    }

    private Task OnSearchChanged(string? value)
    {
        _search = value;
        return CurrentPageChanged.InvokeAsync(1);
    }

    private Task OnQuickFilterChange(string filter)
    {
        _activeQuickFilter = string.Equals(_activeQuickFilter, filter, StringComparison.OrdinalIgnoreCase) ? null : filter;
        return CurrentPageChanged.InvokeAsync(1);
    }
}
