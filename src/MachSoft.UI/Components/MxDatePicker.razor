<MudDatePicker Class="@BuildClass()"
               Label="@Label"
               Date="@Value"
               DateChanged="@ValueChanged"
               Placeholder="@Placeholder"
               HelperText="@HelperText"
               Error="@Error"
               ErrorText="@ErrorText"
               Disabled="@Disabled"
               Margin="Margin.Dense"
               Variant="MudBlazor.Variant.Outlined"
               Editable="true"
               DateFormat="@DateFormat" />

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string HelperText { get; set; } = string.Empty;
    [Parameter] public string ErrorText { get; set; } = string.Empty;
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string DateFormat { get; set; } = "yyyy-MM-dd";
    [Parameter] public string Class { get; set; } = string.Empty;

    private string BuildClass() => string.IsNullOrWhiteSpace(Class) ? "mx-date-picker" : $"mx-date-picker {Class}";
}
