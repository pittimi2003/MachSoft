<div class="mx-state mx-error-state @(Compact ? "mx-state-compact" : string.Empty)">
    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
    <h5>@Title</h5>
    <p>@Description</p>
    @if (Actions is not null)
    {
        <div class="mx-state-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Error";
    [Parameter] public string Description { get; set; } = "No fue posible completar la operación.";
    [Parameter] public bool Compact { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
