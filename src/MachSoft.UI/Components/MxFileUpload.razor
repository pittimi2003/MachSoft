<div class="@BuildClass()">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="mx-file-upload-label">@Label</label>
    }

    <label class="@BuildDropzoneClass()"
           @ondragenter="OnDragEnter"
           @ondragleave="OnDragLeave"
           @ondragover:preventDefault
           @ondrop="OnDrop">
        <InputFile OnChange="OnFileChange" multiple="@Multiple" disabled="@Disabled" accept="@Accept" class="mx-file-upload-input" />
        <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Class="mx-file-upload-icon" />
        <div class="mx-file-upload-content">
            <span class="mx-file-upload-title">@DisplayTitle</span>
            <span class="mx-file-upload-subtitle">@DisplaySubtitle</span>
            @if (Uploading)
            {
                <div class="mx-file-upload-progress">
                    <MxProgress Value="UploadProgress" />
                    <span>Procesando @UploadProgress%</span>
                </div>
            }
        </div>
        <MudIcon Icon="@DropZoneActionIcon" Class="mx-file-upload-state-icon" />
    </label>

    @if (ShowFileList && SelectedFiles.Count > 0)
    {
        <ul class="mx-file-upload-list">
            @foreach (var file in SelectedFiles)
            {
                <li>
                    <div>
                        <strong>@file.Name</strong>
                        <span>@FormatSize(file.Size)</span>
                    </div>
                    @if (!Disabled)
                    {
                        <MxIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Tone="MxTone.Danger" AriaLabel="Quitar archivo" OnClick="_ => RemoveFile(file)" />
                    }
                </li>
            }
        </ul>
    }

    @if (_validationErrors.Count > 0)
    {
        <ul class="mx-file-upload-errors">
            @foreach (var error in _validationErrors)
            {
                <li>@error</li>
            }
        </ul>
    }
    else if (!string.IsNullOrWhiteSpace(HelperText) && !Error)
    {
        <div class="mx-file-upload-helper">@HelperText</div>
    }

    @if (Error)
    {
        <div class="mx-file-upload-error">@ErrorText</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "Selecciona o arrastra archivo(s)";
    [Parameter] public string HelperText { get; set; } = string.Empty;
    [Parameter] public string ErrorText { get; set; } = string.Empty;
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public bool ShowFileList { get; set; } = true;
    [Parameter] public bool Uploading { get; set; }
    [Parameter] public int UploadProgress { get; set; }
    [Parameter] public string Accept { get; set; } = ".pdf,.xlsx,.xls,.csv,.png,.jpg";
    [Parameter] public int MaxFileSizeMb { get; set; } = 15;
    [Parameter] public IReadOnlyList<string> AllowedExtensions { get; set; } = [".pdf", ".xlsx", ".xls", ".csv", ".png", ".jpg"];
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public EventCallback<IBrowserFile?> FileChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> FilesChanged { get; set; }

    private bool _isDragOver;
    private List<IBrowserFile> SelectedFiles { get; set; } = [];
    private readonly List<string> _validationErrors = [];

    private string DisplayTitle => SelectedFiles.Count switch
    {
        0 => Placeholder,
        1 => "1 archivo listo para cargar",
        _ => $"{SelectedFiles.Count} archivos listos para cargar"
    };

    private string DisplaySubtitle => Disabled
        ? "Carga deshabilitada para este flujo."
        : _isDragOver
            ? "Suelta aquí para adjuntar documentos"
            : SelectedFiles.Count == 0
                ? "Arrastra y suelta directamente en esta superficie o haz click para explorar archivos."
                : string.Join(" · ", SelectedFiles.Select(x => x.Name));

    private string DropZoneActionIcon => Error || _validationErrors.Count > 0
        ? Icons.Material.Outlined.ErrorOutline
        : SelectedFiles.Count > 0
            ? Icons.Material.Outlined.TaskAlt
            : Icons.Material.Outlined.CloudUpload;

    private string BuildClass() => string.IsNullOrWhiteSpace(Class) ? "mx-file-upload" : $"mx-file-upload {Class}";

    private string BuildDropzoneClass()
    {
        var classes = "mx-file-upload-dropzone";
        if (SelectedFiles.Count > 0) classes += " mx-file-upload-has-file";
        if (Disabled) classes += " mx-file-upload-disabled";
        if (Error || _validationErrors.Count > 0) classes += " mx-file-upload-invalid";
        if (_isDragOver) classes += " mx-file-upload-dragover";
        return classes;
    }

    private Task OnDragEnter(DragEventArgs _)
    {
        if (!Disabled) _isDragOver = true;
        return Task.CompletedTask;
    }

    private Task OnDragLeave(DragEventArgs _)
    {
        _isDragOver = false;
        return Task.CompletedTask;
    }

    private Task OnDrop(DragEventArgs _)
    {
        _isDragOver = false;
        return Task.CompletedTask;
    }

    private async Task OnFileChange(InputFileChangeEventArgs args)
    {
        _validationErrors.Clear();
        var files = Multiple ? args.GetMultipleFiles() : [args.File];

        foreach (var file in files)
        {
            Validate(file);
        }

        SelectedFiles = _validationErrors.Count == 0 ? files.ToList() : [];
        await FileChanged.InvokeAsync(SelectedFiles.FirstOrDefault());
        await FilesChanged.InvokeAsync(SelectedFiles);
    }

    private void Validate(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (AllowedExtensions.Count > 0 && !AllowedExtensions.Contains(extension))
        {
            _validationErrors.Add($"{file.Name}: tipo no permitido ({extension}).");
        }

        var maxBytes = MaxFileSizeMb * 1024L * 1024L;
        if (file.Size > maxBytes)
        {
            _validationErrors.Add($"{file.Name}: excede el máximo de {MaxFileSizeMb} MB.");
        }
    }

    private async Task RemoveFile(IBrowserFile file)
    {
        SelectedFiles.Remove(file);
        await FileChanged.InvokeAsync(SelectedFiles.FirstOrDefault());
        await FilesChanged.InvokeAsync(SelectedFiles);
    }

    private static string FormatSize(long bytes)
        => bytes < 1024 * 1024
            ? $"{(bytes / 1024d):0.0} KB"
            : $"{(bytes / (1024d * 1024d)):0.00} MB";
}
