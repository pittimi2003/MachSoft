<MudIconButton Class="mx-icon-btn" Icon="@Icon" Color="@MapColor()" Size="@MapSize()" OnClick="OnClick" AriaLabel="@AriaLabel" />

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Settings;
    [Parameter] public string AriaLabel { get; set; } = "action";
    [Parameter] public MxTone Tone { get; set; } = MxTone.Primary;
    [Parameter] public MxSize Size { get; set; } = MxSize.Medium;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private Color MapColor() => Tone switch
    {
        MxTone.Secondary => Color.Secondary,
        MxTone.Success => Color.Success,
        MxTone.Warning => Color.Warning,
        MxTone.Danger => Color.Error,
        MxTone.Neutral => Color.Default,
        _ => Color.Primary
    };

    private MudBlazor.Size MapSize() => Size switch
    {
        MxSize.Small => MudBlazor.Size.Small,
        MxSize.Large => MudBlazor.Size.Large,
        _ => MudBlazor.Size.Medium
    };
}
