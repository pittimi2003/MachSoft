<MudIconButton Icon="@Icon" Color="@MapColor()" Size="@MapSize()" OnClick="OnClick" AriaLabel="@AriaLabel" />

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Settings;
    [Parameter] public string AriaLabel { get; set; } = "action";
    [Parameter] public MxTone Tone { get; set; } = MxTone.Primary;
    [Parameter] public MxSize Size { get; set; } = MxSize.Medium;
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    private Color MapColor() => Tone == MxTone.Secondary ? Color.Secondary : Color.Primary;
    private MudBlazor.Size MapSize() => Size == MxSize.Small ? MudBlazor.Size.Small : MudBlazor.Size.Medium;
}
