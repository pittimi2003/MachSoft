<MudSelect T="string"
           Class="@BuildClass()"
           Label="@Label"
           MultiSelection="true"
           SelectedValues="@SelectedValues"
           SelectedValuesChanged="@OnSelectedChanged"
           Placeholder="@Placeholder"
           HelperText="@HelperText"
           Error="@Error"
           ErrorText="@ErrorText"
           Disabled="@Disabled"
           Margin="Margin.Dense"
           Variant="MudBlazor.Variant.Outlined"
           FullWidth="true"
           Delimiter=", ">
    @foreach (var option in Options)
    {
        <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
    }
</MudSelect>
@if (SelectedValues.Any())
{
    <div class="mx-multiselect-chips">
        @foreach (var value in SelectedValues)
        {
            <button type="button" class="mx-multiselect-chip-btn" @onclick="() => Remove(value)"><MxChip Text="@value" /></button>
        }
    </div>
}

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public IEnumerable<string> SelectedValues { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<IEnumerable<string>> SelectedValuesChanged { get; set; }
    [Parameter] public IReadOnlyList<string> Options { get; set; } = [];
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string HelperText { get; set; } = string.Empty;
    [Parameter] public string ErrorText { get; set; } = string.Empty;
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string BuildClass() => string.IsNullOrWhiteSpace(Class) ? "mx-multiselect mx-select" : $"mx-multiselect mx-select {Class}";
    private Task OnSelectedChanged(IEnumerable<string> values) => SelectedValuesChanged.InvokeAsync(values.ToArray());

    private Task Remove(string value)
        => SelectedValuesChanged.InvokeAsync(SelectedValues.Where(v => v != value).ToArray());
}
