<div class="mx-page-container">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <MudText Typo="Typo.h4">@Title</MudText>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
