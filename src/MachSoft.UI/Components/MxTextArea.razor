<MudTextField T="string"
              Class="@BuildClass()"
              Label="@Label"
              Value="@Value"
              ValueChanged="@ValueChanged"
              Placeholder="@Placeholder"
              HelperText="@HelperText"
              Error="@Error"
              ErrorText="@ErrorText"
              Disabled="@Disabled"
              Variant="MudBlazor.Variant.Outlined"
              Margin="Margin.Dense"
              Immediate="true"
              Lines="@Lines"
              AutoGrow="@AutoGrow"
              FullWidth="true" />

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string HelperText { get; set; } = string.Empty;
    [Parameter] public string ErrorText { get; set; } = string.Empty;
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int Lines { get; set; } = 4;
    [Parameter] public bool AutoGrow { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string BuildClass() => string.IsNullOrWhiteSpace(Class) ? "mx-textarea" : $"mx-textarea {Class}";
}
