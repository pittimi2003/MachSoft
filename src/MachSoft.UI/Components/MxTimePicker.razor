<MudTimePicker Class="mx-input" Label="@Label" Time="@Value" TimeChanged="ValueChanged" HelperText="@HelperText" Disabled="@Disabled" AmPm="false" />
@code {
 [Parameter] public string Label { get; set; } = string.Empty;
 [Parameter] public TimeSpan? Value { get; set; }
 [Parameter] public EventCallback<TimeSpan?> ValueChanged { get; set; }
 [Parameter] public string HelperText { get; set; } = string.Empty;
 [Parameter] public bool Disabled { get; set; }
}
