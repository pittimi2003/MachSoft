<div class="mx-workspace-layout @Class"
     style="--mx-navigation-menu-width:@ResolvedNavigationMenuWidth; --mx-left-sidebar-width:@ResolvedLeftSidebarWidth; --mx-right-sidebar-width:@ResolvedRightSidebarWidth; @Style"
     data-main-menu-open="@MainMenuOpen.ToString().ToLowerInvariant()"
     data-navigation-mode="@NavigationMenuMode.ToString().ToLowerInvariant()"
     data-navigation-mode-effective="@EffectiveNavigationMenuMode.ToString().ToLowerInvariant()"
     data-left-mode="@LeftSidebarMode.ToString().ToLowerInvariant()"
     data-right-mode="@RightSidebarMode.ToString().ToLowerInvariant()"
     data-left-open="@LeftSidebarOpen.ToString().ToLowerInvariant()"
     data-right-open="@RightSidebarOpen.ToString().ToLowerInvariant()">
    <header class="mx-workspace-header" data-header-height="48">
        <div class="mx-workspace-header-primary">
            <button type="button"
                    class="mx-workspace-menu-toggle"
                    aria-label="Alternar menú principal"
                    aria-expanded="@MainMenuOpen.ToString().ToLowerInvariant()"
                    title="Alternar menú principal"
                    @onclick="ToggleMainMenuAsync">
                <span aria-hidden="true">☰</span>
            </button>

            @if (HeaderContent is not null)
            {
                <div class="mx-workspace-header-content">@HeaderContent</div>
            }

            <MxMenu Class="mx-workspace-shell-control-menu"
                    Label="Shell"
                    Icon="@Icons.Material.Outlined.Tune"
                    Tone="MxTone.Neutral"
                    Items="@ShellControlItems"
                    OnItemSelected="OnShellControlItemSelectedAsync" />
        </div>
    </header>

    <div class="mx-workspace-body">
        <section class="mx-workspace-functional-grid" style="grid-template-columns:@WorkspaceGridColumns;">
            @if (HasLeftInlineRegion)
            {
                <aside class="mx-workspace-sidebar mx-workspace-sidebar-inline mx-workspace-sidebar-left" data-sidebar="left" data-mode="inline">
                    @LeftSidebar
                </aside>
            }

            <section class="mx-workspace-main-region @MainRegionVisualStateClass"
                     style="--mx-main-visual-shift:@MainRegionVisualShift;"
                     data-main-structural-span="@MainRegionStructuralSpan"
                     data-main-visual-state="@MainRegionVisualState">
                <main class="mx-workspace-main">@MainContent</main>
                @if (FooterContent is not null)
                {
                    <footer class="mx-workspace-footer">@FooterContent</footer>
                }
            </section>

            @if (HasRightInlineRegion)
            {
                <aside class="mx-workspace-sidebar mx-workspace-sidebar-inline mx-workspace-sidebar-right" data-sidebar="right" data-mode="inline">
                    @RightSidebar
                </aside>
            }
        </section>

        @if (HasAnyOverlayVisible)
        {
            <button type="button"
                    class="mx-workspace-backdrop"
                    aria-label="Fondo de panel lateral"
                    @onclick="OnBackdropInteractionAsync"></button>
        }

        <div class="mx-workspace-overlay-layer" data-overlay-layer-open="@HasAnyOverlayVisible.ToString().ToLowerInvariant()">
            @if (IsNavigationMenuOverlayVisible)
            {
                <aside class="mx-workspace-navigation-menu mx-workspace-navigation-menu-overlay" data-region="navigation-menu" data-mode="overlay">
                    @NavigationMenu
                </aside>
            }

            @if (HasLeftOverlayRegion)
            {
                <aside class="mx-workspace-sidebar mx-workspace-sidebar-overlay mx-workspace-sidebar-left" data-sidebar="left" data-mode="overlay">
                    @LeftSidebar
                </aside>
            }

            @if (HasRightOverlayRegion)
            {
                <aside class="mx-workspace-sidebar mx-workspace-sidebar-overlay mx-workspace-sidebar-right" data-sidebar="right" data-mode="overlay">
                    @RightSidebar
                </aside>
            }
        </div>

    </div>
</div>

@code {
    private const string LeftModeInlineKey = "left.mode.inline";
    private const string LeftModeOverlayKey = "left.mode.overlay";
    private const string LeftOpenToggleKey = "left.open.toggle";
    private const string RightModeInlineKey = "right.mode.inline";
    private const string RightModeOverlayKey = "right.mode.overlay";
    private const string RightOpenToggleKey = "right.open.toggle";

    /// <summary>
    /// Región declarativa para extender el header persistente del shell.
    /// </summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>
    /// Región declarativa para navegación global de la aplicación, independiente del sidebar funcional izquierdo.
    /// </summary>
    [Parameter] public RenderFragment? NavigationMenu { get; set; }

    /// <summary>
    /// Región declarativa para el sidebar izquierdo funcional (acciones rápidas, filtros, comandos de feature).
    /// </summary>
    [Parameter] public RenderFragment? LeftSidebar { get; set; }

    /// <summary>
    /// Región principal de trabajo (grids, formularios, dashboards y contenido de negocio).
    /// </summary>
    [Parameter] public RenderFragment MainContent { get; set; } = default!;

    /// <summary>
    /// Región declarativa para el sidebar derecho funcional (detalle contextual, edición, formularios inline).
    /// </summary>
    [Parameter] public RenderFragment? RightSidebar { get; set; }

    /// <summary>
    /// Región opcional para acciones secundarias, estado o paginación del área central.
    /// </summary>
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>
    /// Estado del menú principal a nivel shell. Inicia en <c>false</c> por defecto.
    /// </summary>
    [Parameter] public bool MainMenuOpen { get; set; }

    /// <summary>
    /// Callback de sincronización para <see cref="MainMenuOpen"/>.
    /// </summary>
    [Parameter] public EventCallback<bool> MainMenuOpenChanged { get; set; }

    /// <summary>
    /// Modo solicitado para el menú principal. En esta iteración el shell soporta <see cref="MxSidebarMode.Overlay"/> de forma estable.
    /// </summary>
    [Parameter] public MxSidebarMode NavigationMenuMode { get; set; } = MxSidebarMode.Overlay;

    /// <summary>
    /// Ancho CSS del menú principal (ej. 280px, 20rem).
    /// </summary>
    [Parameter] public string NavigationMenuWidth { get; set; } = "288px";

    /// <summary>
    /// Define el modo del sidebar izquierdo funcional.
    /// </summary>
    [Parameter] public MxSidebarMode LeftSidebarMode { get; set; } = MxSidebarMode.Inline;

    /// <summary>
    /// Define el modo del sidebar derecho funcional.
    /// </summary>
    [Parameter] public MxSidebarMode RightSidebarMode { get; set; } = MxSidebarMode.Overlay;

    /// <summary>
    /// Estado de apertura del sidebar izquierdo cuando se usa en modo overlay.
    /// </summary>
    [Parameter] public bool LeftSidebarOpen { get; set; }

    /// <summary>
    /// Callback de sincronización para <see cref="LeftSidebarOpen"/>.
    /// </summary>
    [Parameter] public EventCallback<bool> LeftSidebarOpenChanged { get; set; }

    /// <summary>
    /// Estado de apertura del sidebar derecho cuando se usa en modo overlay.
    /// </summary>
    [Parameter] public bool RightSidebarOpen { get; set; }

    /// <summary>
    /// Callback de sincronización para <see cref="RightSidebarOpen"/>.
    /// </summary>
    [Parameter] public EventCallback<bool> RightSidebarOpenChanged { get; set; }

    /// <summary>
    /// Callback de sincronización para <see cref="LeftSidebarMode"/>.
    /// </summary>
    [Parameter] public EventCallback<MxSidebarMode> LeftSidebarModeChanged { get; set; }

    /// <summary>
    /// Callback de sincronización para <see cref="RightSidebarMode"/>.
    /// </summary>
    [Parameter] public EventCallback<MxSidebarMode> RightSidebarModeChanged { get; set; }

    /// <summary>
    /// Ancho CSS del sidebar izquierdo funcional (ej. 300px, 20rem, minmax(240px, 30vw)).
    /// </summary>
    [Parameter] public string LeftSidebarWidth { get; set; } = "320px";

    /// <summary>
    /// Ancho CSS del sidebar derecho funcional (ej. 360px, 24rem).
    /// </summary>
    [Parameter] public string RightSidebarWidth { get; set; } = "360px";

    /// <summary>
    /// Callback de notificación para el gesto de toggle del menú principal.
    /// </summary>
    [Parameter] public EventCallback OnMenuToggle { get; set; }

    /// <summary>
    /// Callback opcional para interacción sobre backdrop de overlays.
    /// </summary>
    [Parameter] public EventCallback OnBackdropClick { get; set; }

    /// <summary>
    /// Clase adicional opcional para el root del layout.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Estilos inline adicionales opcionales para el root del layout.
    /// </summary>
    [Parameter] public string? Style { get; set; }

    private MxSidebarMode EffectiveNavigationMenuMode => MxSidebarMode.Overlay;
    private bool IsNavigationMenuOverlayVisible => EffectiveNavigationMenuMode == MxSidebarMode.Overlay && MainMenuOpen && NavigationMenu is not null;
    private bool HasLeftInlineRegion => LeftSidebar is not null && LeftSidebarMode == MxSidebarMode.Inline;
    private bool HasRightInlineRegion => RightSidebar is not null && RightSidebarMode == MxSidebarMode.Inline;
    private bool HasLeftOverlayRegion => LeftSidebar is not null && LeftSidebarMode == MxSidebarMode.Overlay && LeftSidebarOpen;
    private bool HasRightOverlayRegion => RightSidebar is not null && RightSidebarMode == MxSidebarMode.Overlay && RightSidebarOpen;
    private bool IsLeftOverlayOpen => LeftSidebar is not null && LeftSidebarMode == MxSidebarMode.Overlay && LeftSidebarOpen;
    private bool IsRightOverlayOpen => RightSidebar is not null && RightSidebarMode == MxSidebarMode.Overlay && RightSidebarOpen;
    private bool HasAnyOverlayVisible => IsNavigationMenuOverlayVisible || HasLeftOverlayRegion || HasRightOverlayRegion;

    private IReadOnlyList<MxMenuItem> ShellControlItems =>
    [
        new(LeftModeInlineKey, LeftSidebarMode == MxSidebarMode.Inline ? "Left: Inline ✓" : "Left: Inline", Icons.Material.Outlined.ViewWeek),
        new(LeftModeOverlayKey, LeftSidebarMode == MxSidebarMode.Overlay ? "Left: Overlay ✓" : "Left: Overlay", Icons.Material.Outlined.Layers),
        new(LeftOpenToggleKey, LeftSidebarOpen ? "Left: Cerrar overlay" : "Left: Abrir overlay", Icons.Material.Outlined.ChevronLeft, LeftSidebarMode == MxSidebarMode.Inline),
        new(RightModeInlineKey, RightSidebarMode == MxSidebarMode.Inline ? "Right: Inline ✓" : "Right: Inline", Icons.Material.Outlined.ViewWeek),
        new(RightModeOverlayKey, RightSidebarMode == MxSidebarMode.Overlay ? "Right: Overlay ✓" : "Right: Overlay", Icons.Material.Outlined.Layers),
        new(RightOpenToggleKey, RightSidebarOpen ? "Right: Cerrar overlay" : "Right: Abrir overlay", Icons.Material.Outlined.ChevronRight, RightSidebarMode == MxSidebarMode.Inline)
    ];

    private string ResolvedNavigationMenuWidth => string.IsNullOrWhiteSpace(NavigationMenuWidth) ? "288px" : NavigationMenuWidth.Trim();
    private string ResolvedLeftSidebarWidth => string.IsNullOrWhiteSpace(LeftSidebarWidth) ? "320px" : LeftSidebarWidth.Trim();
    private string ResolvedRightSidebarWidth => string.IsNullOrWhiteSpace(RightSidebarWidth) ? "360px" : RightSidebarWidth.Trim();

    private string WorkspaceGridColumns
    {
        get
        {
            var left = HasLeftInlineRegion ? ResolvedLeftSidebarWidth : "0px";
            var right = HasRightInlineRegion ? ResolvedRightSidebarWidth : "0px";
            return $"{left} minmax(0, 1fr) {right}";
        }
    }

    private string MainRegionVisualShift => (IsLeftOverlayOpen, IsRightOverlayOpen) switch
    {
        (true, true) => "calc(var(--mx-left-sidebar-width) - var(--mx-right-sidebar-width))",
        (true, false) => "var(--mx-left-sidebar-width)",
        (false, true) => "calc(var(--mx-right-sidebar-width) * -1)",
        _ => "0px"
    };

    private string MainRegionVisualState => (IsLeftOverlayOpen, IsRightOverlayOpen) switch
    {
        (true, true) => "shift-both",
        (true, false) => "shift-left",
        (false, true) => "shift-right",
        _ => "neutral"
    };

    private string MainRegionVisualStateClass => MainRegionVisualState switch
    {
        "shift-left" => "mx-workspace-main-region-shift-left",
        "shift-right" => "mx-workspace-main-region-shift-right",
        "shift-both" => "mx-workspace-main-region-shift-both",
        _ => "mx-workspace-main-region-neutral"
    };

    private string MainRegionStructuralSpan => (HasLeftInlineRegion, HasRightInlineRegion) switch
    {
        (false, false) => "full",
        (true, false) => "center-with-left-inline",
        (false, true) => "center-with-right-inline",
        _ => "center-with-both-inline"
    };

    private async Task ToggleMainMenuAsync()
    {
        await SetMainMenuOpenAsync(!MainMenuOpen);

        if (OnMenuToggle.HasDelegate)
        {
            await OnMenuToggle.InvokeAsync();
        }
    }

    private async Task OnBackdropInteractionAsync()
    {
        if (MainMenuOpen)
        {
            await SetMainMenuOpenAsync(false);
        }

        if (LeftSidebarMode == MxSidebarMode.Overlay && LeftSidebarOpen)
        {
            await SetLeftSidebarOpenAsync(false);
        }

        if (RightSidebarMode == MxSidebarMode.Overlay && RightSidebarOpen)
        {
            await SetRightSidebarOpenAsync(false);
        }

        if (OnBackdropClick.HasDelegate)
        {
            await OnBackdropClick.InvokeAsync();
        }
    }

    private async Task OnShellControlItemSelectedAsync(string key)
    {
        switch (key)
        {
            case LeftModeInlineKey:
                await SetLeftSidebarModeAsync(MxSidebarMode.Inline);
                break;
            case LeftModeOverlayKey:
                await SetLeftSidebarModeAsync(MxSidebarMode.Overlay);
                break;
            case LeftOpenToggleKey when LeftSidebarMode == MxSidebarMode.Overlay:
                await SetLeftSidebarOpenAsync(!LeftSidebarOpen);
                break;
            case RightModeInlineKey:
                await SetRightSidebarModeAsync(MxSidebarMode.Inline);
                break;
            case RightModeOverlayKey:
                await SetRightSidebarModeAsync(MxSidebarMode.Overlay);
                break;
            case RightOpenToggleKey when RightSidebarMode == MxSidebarMode.Overlay:
                await SetRightSidebarOpenAsync(!RightSidebarOpen);
                break;
        }
    }

    private async Task SetMainMenuOpenAsync(bool next)
    {
        if (MainMenuOpen == next)
        {
            return;
        }

        MainMenuOpen = next;

        if (MainMenuOpenChanged.HasDelegate)
        {
            await MainMenuOpenChanged.InvokeAsync(next);
        }
    }

    private async Task SetLeftSidebarOpenAsync(bool next)
    {
        if (LeftSidebarOpen == next)
        {
            return;
        }

        LeftSidebarOpen = next;

        if (LeftSidebarOpenChanged.HasDelegate)
        {
            await LeftSidebarOpenChanged.InvokeAsync(next);
        }
    }

    private async Task SetRightSidebarOpenAsync(bool next)
    {
        if (RightSidebarOpen == next)
        {
            return;
        }

        RightSidebarOpen = next;

        if (RightSidebarOpenChanged.HasDelegate)
        {
            await RightSidebarOpenChanged.InvokeAsync(next);
        }
    }

    private async Task SetLeftSidebarModeAsync(MxSidebarMode next)
    {
        if (LeftSidebarMode == next)
        {
            return;
        }

        LeftSidebarMode = next;

        if (LeftSidebarModeChanged.HasDelegate)
        {
            await LeftSidebarModeChanged.InvokeAsync(next);
        }

        if (next == MxSidebarMode.Inline && LeftSidebarOpen)
        {
            await SetLeftSidebarOpenAsync(false);
        }
    }

    private async Task SetRightSidebarModeAsync(MxSidebarMode next)
    {
        if (RightSidebarMode == next)
        {
            return;
        }

        RightSidebarMode = next;

        if (RightSidebarModeChanged.HasDelegate)
        {
            await RightSidebarModeChanged.InvokeAsync(next);
        }

        if (next == MxSidebarMode.Inline && RightSidebarOpen)
        {
            await SetRightSidebarOpenAsync(false);
        }
    }
}
